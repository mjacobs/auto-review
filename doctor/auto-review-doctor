@dataclass
class JobReport:
    name: str
    expected_hhmm: str
    fired: bool                   # marker path: commit seen today; PG path: row is fresh
    fired_at_pt: str | None      # "20:01" if today, "(2026-05-15)" if older
    section_present: bool | None  # None = N/A (not expected today / PG job)
    section_lines: int | None
    section_note: str             # "0 captures", "" etc.
    skipped_reason: str | None    # e.g. "weekly — Mondays only"
    tracebacks: list[str] = field(default_factory=list)
    # ── PG path (auto-review-hg6.8) ──
    pg: bool = False              # liveness came from ops.job_runs, not log+marker
    pg_status: str | None = None  # 'ok'|'error' from the row, 'degraded' (no PG), None (no row)
    pg_cost: str | None = None    # formatted "$0.0400", or None
    pg_overdue: bool = False      # a row exists but is older than the window


def tail_lines(path: Path, n: int) -> list[str]:
    if not path.exists():
        return []
    # Stdlib-friendly tail: read whole file. cron.log is ~6k lines today;
    # rotation work (auto-review-75t) is tracked separately. Good enough for v0.
    with path.open("r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    return lines[-n:]


def parse_utc_iso(s: str) -> dt.datetime:
    # "2026-05-18T03:01:01Z"
    return dt.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)


@dataclass(frozen=True)
class RunRow:
    """One latest ops.job_runs row, for a PG-monitored job's liveness."""
    job_name: str
    finished_at: dt.datetime     # UTC
    status: str                  # 'ok' | 'error'
    cost_usd: float | None


def _rows_to_runmap(rows: list[list[str]]) -> dict[str, RunRow]:
    """Parse psql `-At -F\\t` rows into {job_name: RunRow}. Malformed rows are
    skipped rather than fatal — a parse hiccup must not blind the whole report."""
    out: dict[str, RunRow] = {}
    for r in rows:
        if len(r) < 4:
            continue
        job_name, finished, status, cost = r[0], r[1], r[2], r[3]
        try:
            ts = parse_utc_iso(finished)
        except ValueError:
            continue
        cost_usd: float | None = None
        if cost not in ("", None):
            try:
                cost_usd = float(cost)
            except ValueError:
                cost_usd = None
        out[job_name] = RunRow(job_name=job_name, finished_at=ts, status=status, cost_usd=cost_usd)
    return out


def query_latest_runs(dsn: str | None) -> dict[str, RunRow] | None:
    """Latest ops.job_runs row per job_name via a `psql -At` subprocess.

    Returns None — signalling "degrade to the log/marker path" — when there's no
    DSN, psql isn't on PATH, or the query fails/times out, so the doctor still
    runs on a box without PG. Keeping this a subprocess (not psycopg) is what lets
    the doctor stay a single stdlib-only file.
    """
    if not dsn or not shutil.which("psql"):
        return None
    try:
        proc = subprocess.run(
            ["psql", dsn, "-At", "-F", "\t", "-v", "ON_ERROR_STOP=1", "-c", SQL_LATEST_RUNS],
            capture_output=True, text=True, timeout=PSQL_TIMEOUT_S,
            env={**os.environ, "PGCONNECT_TIMEOUT": "8"},
        )
    except (subprocess.SubprocessError, OSError):
        return None
    if proc.returncode != 0:
        return None
    rows = [line.split("\t") for line in proc.stdout.splitlines() if line.strip()]
    return _rows_to_runmap(rows)


def assess_pg_job(
    job: Job, today_pt: dt.date, pg_runs: dict[str, RunRow] | None, now_utc: dt.datetime
) -> JobReport:
    """Build a JobReport for a PG-monitored job from the latest-runs map.

    pg_runs is None when PG is unreachable (degraded: liveness unknown); a job
    absent from the map has never recorded a run; otherwise liveness is whether
    the latest row is younger than the job's window.
    """
    base = dict(
        name=job.name, expected_hhmm=job.cadence, section_present=None,
        section_lines=None, section_note="", skipped_reason=None, pg=True,
    )
    if pg_runs is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status="degraded", **base)
    row = pg_runs.get(job.pg_job_name)
    if row is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status=None, **base)
    age_h = (now_utc - row.finished_at).total_seconds() / 3600.0
    fresh = age_h <= job.pg_interval_hours
    ts_pt = row.finished_at.astimezone(PT)
    fired_at = ts_pt.strftime("%H:%M") if ts_pt.date() == today_pt else f"({ts_pt.date().isoformat()})"
    cost = f"${row.cost_usd:.4f}" if row.cost_usd is not None else None
    return JobReport(
        fired=fresh, fired_at_pt=fired_at, pg_status=row.status,
        pg_cost=cost, pg_overdue=not fresh, **base,
    )


def most_recent_weekly_fire(job: Job, now_utc: dt.datetime) -> dt.datetime:
    """The most-recent EXPECTED weekly fire (UTC) at-or-before ``now_utc``.

    The weekly cron fires at ``pg_weekly_hhmm`` PT on ``pg_weekly_dow`` (Monday).
    We compute the fire instant in PT, then convert to UTC for comparison with
    the row's (UTC) finished_at. "At-or-before now" so that AFTER this week's fire
    has passed we measure against THIS week's expected run, and before it we
    measure against LAST week's — which is what makes the check both per-week
    (a real miss surfaces) and free of the pre-fire-Monday false-positive.
    """
    hh, mm = (int(x) for x in job.pg_weekly_hhmm.split(":"))
    now_pt = now_utc.astimezone(PT)
    # Walk back to the most recent scheduled weekday at hh:mm that is <= now_pt.
    days_since_dow = (now_pt.weekday() - job.pg_weekly_dow) % 7
    fire_date = now_pt.date() - dt.timedelta(days=days_since_dow)
    fire_pt = dt.datetime.combine(fire_date, dt.time(hh, mm), tzinfo=PT)
    if fire_pt > now_pt:
        # Today IS the scheduled day but we're before the fire time → last week's.
        fire_pt -= dt.timedelta(weeks=1)
    return fire_pt.astimezone(UTC)


def assess_pg_weekly_job(
    job: Job, today_pt: dt.date, pg_runs: dict[str, RunRow] | None, now_utc: dt.datetime
) -> JobReport:
    """Schedule-aware liveness for a weekly PG job (auto-review-2vv).

    A flat age window can't express a weekly cadence: an 8-day window stays green
    for ~8 days after a real miss, and a tight window false-positives every Monday
    before the fire (the hg6.12 BUG2). Instead: the job is FRESH unless the
    most-recent expected Monday fire (+grace) has passed without a row finishing
    at-or-after that fire. So:
      * before this Monday's fire → measured against LAST week's fire, which a
        normal run already satisfied → green (no BUG2 false-positive);
      * after the fire+grace with no fresh row → overdue (a real miss surfaces,
        and stays surfaced for the whole week, not silently self-clearing).
    """
    base = dict(
        name=job.name, expected_hhmm=job.cadence, section_present=None,
        section_lines=None, section_note="", skipped_reason=None, pg=True,
    )
    if pg_runs is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status="degraded", **base)
    row = pg_runs.get(job.pg_job_name)
    if row is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status=None, **base)

    expected_fire = most_recent_weekly_fire(job, now_utc)
    deadline = expected_fire + dt.timedelta(hours=job.pg_grace_hours)
    # Fresh if the latest row covers the most-recent expected fire, OR we haven't
    # yet reached that fire's grace deadline (the run still has time to land).
    fresh = row.finished_at >= expected_fire or now_utc < deadline

    ts_pt = row.finished_at.astimezone(PT)
    fired_at = ts_pt.strftime("%H:%M") if ts_pt.date() == today_pt else f"({ts_pt.date().isoformat()})"
    cost = f"${row.cost_usd:.4f}" if row.cost_usd is not None else None
    return JobReport(
        fired=fresh, fired_at_pt=fired_at, pg_status=row.status,
        pg_cost=cost, pg_overdue=not fresh, **base,
    )


def latest_match(lines: list[str], pattern: re.Pattern[str]) -> tuple[str, dt.datetime] | None:
    last: tuple[str, dt.datetime] | None = None
    for line in lines:
        m = pattern.search(line)
        if m:
            try:
                last = (line.rstrip(), parse_utc_iso(m.group(1)))
            except ValueError:
                continue
    return last


def section_info(text: str, tool: str, marker_key: str, label: str) -> tuple[bool, int, str]:
    """Find `<!-- {tool}:{marker_key}={label} ... -->` and its matching `## {tool} …` heading.

    `marker_key`/`label` are "daily"/"YYYY-MM-DD" or "weekly"/"YYYY-W##", matching the
    marker each sibling emits (see vault-review's vault.py).

    Returns (present, line_count_inside, note).
    """
    close_marker = re.compile(
        rf"^<!--\s*{re.escape(tool)}:{re.escape(marker_key)}={re.escape(label)}\s+generated_at=\S+\s*-->$",
        re.MULTILINE,
    )
    cm = close_marker.search(text)
    if not cm:
        return (False, 0, "")
    # The close marker already pins tool+kind+label, so the section start is just
    # the nearest `## {tool} …` heading before it. Don't key the heading on the
    # date — weekly headings are keyed on the week, not a daily date. Consume the
    # whole heading line so its text stays out of the body line count.
    # Hyphens in the tool name may render as spaces in the heading (e.g. marker
    # `auto-review-doctor` → heading `## auto-review doctor`), so match either.
    tool_pat = re.escape(tool).replace(r"\-", "[- ]")
    open_marker = re.compile(rf"^##\s+{tool_pat}\b[^\n]*$", re.MULTILINE)
    om = None
    for m in open_marker.finditer(text):
        if m.start() < cm.start():
            om = m
    if not om:
        return (True, 0, "(close marker found, open heading missing)")
    body = text[om.end():cm.start()]
    line_count = sum(1 for line in body.splitlines() if line.strip())
    note = ""
    if "0 captures" in body or "no captures in window" in body:
        note = "0 captures"
    return (True, line_count, note)


def find_tracebacks(lines: list[str]) -> list[dict[str, str]]:
    tracebacks = []
    n = len(lines)
    i = 0
    while i < n:
        if lines[i].startswith("Traceback (most recent call last):"):
            block_lines = [lines[i]]
            j = i + 1
            while j < n:
                if lines[j].startswith(" ") or lines[j].startswith("\t") or not lines[j].strip():
                    block_lines.append(lines[j])
                    j += 1
                else:
                    block_lines.append(lines[j])
                    j += 1
                    break
            
            file_path = None
            line_no = None
            for tbl in reversed(block_lines):
                m = re.search(r'File "([^"]+)", line (\d+)', tbl)
                if m:
                    file_path = m.group(1)
                    line_no = m.group(2)
                    break
            
            exc_line = block_lines[-1].strip() if block_lines else "UnknownError"
            
            tool = "other"
            if file_path:
                fp_lower = file_path.lower()
                if "vault-review" in fp_lower or "vault_review" in fp_lower:
                    tool = "vault-review"
                elif "memex-review" in fp_lower or "memex_review" in fp_lower:
                    tool = "memex-review"
                elif "agent-review" in fp_lower or "agent_review" in fp_lower:
                    tool = "agent-review"
                elif "doctor" in fp_lower or "auto-review-doctor" in fp_lower:
                    tool = "auto-review-doctor"
            
            exc_match = re.match(r'^([\w\.]+):\s*(.*)$', exc_line)
            if exc_match:
                exc_type = exc_match.group(1).split('.')[-1]
                exc_msg = exc_match.group(2)
                exc_summary = f"{exc_type}: {exc_msg}"
            else:
                exc_summary = exc_line
            
            loc = ""
            if file_path:
                loc = f" ({Path(file_path).name}:{line_no})"
            
            tracebacks.append({
                "tool": tool,
                "summary": f"{exc_summary}{loc}",
                "full_text": "".join(block_lines)
            })
            i = j
        else:
            i += 1
    return tracebacks


# git's per-ref rejection line, e.g. " ! [rejected]  main -> main (non-fast-forward)".
# One match == one rejected push. Healed automatically by the wrappers' rebase+retry
# (464110b), so this is a tripwire for the rare double-race, not a hard failure.
PUSH_REJECT = re.compile(r"!\s+\[rejected\].*\((?:non-fast-forward|fetch first)\)")


def count_push_rejections(lines: list[str]) -> int:
    return sum(1 for line in lines if PUSH_REJECT.search(line))


def assess_jobs(
    log_lines: list[str],
    today_pt: dt.date,
    yesterday_checkin_text: str,
    weekly_text: str,
    tracebacks: list[dict[str, str]],
    pg_runs: dict[str, RunRow] | None = None,
    now_utc: dt.datetime | None = None,
) -> list[JobReport]:
    now_utc = now_utc or dt.datetime.now(UTC)
    reports: list[JobReport] = []
    for job in JOBS:
        if not job.monitored:
            continue  # catalogued infra; liveness not checked (see moving-pieces doc)
        if job.pg_job_name:
            # PG-monitored: liveness is a fresh ops.job_runs row (hg6.8). The
            # weekly variant (auto-review-2vv) is schedule-aware rather than a flat
            # age window. pg_runs is None when PG is unreachable (degraded).
            if job.pg_weekly:
                reports.append(assess_pg_weekly_job(job, today_pt, pg_runs, now_utc))
            else:
                reports.append(assess_pg_job(job, today_pt, pg_runs, now_utc))
            continue
        name, hhmm, regex, sibling_tool, is_weekly, marker_key = (
            job.name, job.hhmm, job.commit_regex, job.marker_tool, job.is_weekly, job.marker_key,
        )
        if sibling_tool == "auto-review-doctor":
            # Self-row. We can't see our own commit in the log yet (it happens
            # after this script exits, in the cron wrapper), so "fired" reflects
            # this very run. But the section cell is now a REAL check of
            # yesterday's check-in for our own marker — that's our day-to-day
            # liveness signal. Multi-day gaps are surfaced separately by the
            # self-liveness line (see doctor_self_liveness).
            yday = today_pt - dt.timedelta(days=1)
            present, lines, note = section_info(
                yesterday_checkin_text, "auto-review-doctor", "daily", yday.isoformat()
            )
            reports.append(JobReport(
                name=name, expected_hhmm=hhmm, fired=True, fired_at_pt="now",
                section_present=present, section_lines=lines,
                section_note=note or "self", skipped_reason=None,
                tracebacks=[],
            ))
            continue
        match = latest_match(log_lines, regex)
        
        # Get tracebacks for this tool
        job_tracebacks = [tb["summary"] for tb in tracebacks if tb["tool"] == sibling_tool]
        
        if match is None:
            reports.append(JobReport(
                name=name, expected_hhmm=hhmm, fired=False, fired_at_pt=None,
                section_present=False, section_lines=0, section_note="",
                skipped_reason=None,
                tracebacks=job_tracebacks,
            ))
            continue
        _, ts_utc = match
        ts_pt = ts_utc.astimezone(PT)
        fired_today = ts_pt.date() == today_pt
        fired_at = ts_pt.strftime("%H:%M") if fired_today else f"({ts_pt.date().isoformat()})"
        if is_weekly:
            # The weekly cron runs `run-weekly last-week` on Monday, writing a
            # section for the ISO week that just ended (Mon–Sun), into
            # journal/weekly/YYYY-W##.md keyed `:weekly=YYYY-W##`.
            present, lines, note = section_info(
                weekly_text, sibling_tool, marker_key, reported_week_label(today_pt)
            )
        else:
            yesterday = today_pt - dt.timedelta(days=1)
            present, lines, note = section_info(
                yesterday_checkin_text, sibling_tool, marker_key, yesterday.isoformat()
            )
        reports.append(JobReport(
            name=name, expected_hhmm=hhmm, fired=fired_today,
            fired_at_pt=fired_at, section_present=present, section_lines=lines,
            section_note=note, skipped_reason=None,
            tracebacks=job_tracebacks,
        ))
    return reports


def format_self_liveness(today_pt: dt.date, last_present: dt.date | None, gaps: list[dt.date]) -> str:
    """One-line in-band liveness of the doctor itself, over the lookback window."""
    if last_present is None:
        return (
            f"_⚠️ doctor self-liveness: no doctor section found in the last "
            f"{SELF_LIVENESS_WINDOW} days — has this job ever run?_"
        )
    days_ago = (today_pt - last_present).days
    ago = "yesterday" if days_ago == 1 else f"{days_ago}d ago"
    if gaps:
        missed = ", ".join(d.isoformat() for d in gaps)
        return (
            f"_⚠️ doctor self-liveness: last section {last_present.isoformat()} "
            f"({ago}) — missed run(s): {missed}_"
        )
    return f"_doctor self-liveness: last section {last_present.isoformat()} ({ago}) — no gaps_"


def _pg_run_cell(r: JobReport) -> str:
    """The 'last run' cell for a PG-monitored job."""
    if r.pg_status == "degraded":
        return "⚠️ unknown (no PG)"
    if r.fired_at_pt is None:          # no row ever recorded
        return "❌ never"
    when = f"{r.fired_at_pt} PT" if ":" in r.fired_at_pt else r.fired_at_pt
    if r.fired:                        # fresh: latest row within the window
        return f"✓ {when}"
    return f"❌ overdue (last {when})"  # a row exists but it's stale


def _pg_result_cell(r: JobReport) -> str:
    """The 'latest result' cell for a PG-monitored job: status + cost."""
    if r.pg_status in ("degraded", None):
        return "—"
    icon = "✓" if r.pg_status == "ok" else "⚠️"
    cell = f"{icon} {r.pg_status}"
    if r.pg_cost:
        cell += f" · {r.pg_cost}"
    return cell


def render_section(today_pt: dt.date, reports: list[JobReport], tracebacks: list[dict[str, str]], push_rejections: int, self_liveness: tuple[dt.date | None, list[dt.date]]) -> str:
    now_utc = dt.datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    expected = [r for r in reports if r.skipped_reason is None]
    fired = [r for r in expected if r.fired]
    yesterday = today_pt - dt.timedelta(days=1)
    
    tb_count = len(tracebacks)
    reject_cell = f"{push_rejections} push rejections" if push_rejections == 0 else f"⚠️ {push_rejections} push rejections"
    summary = f"_{len(fired)}/{len(expected)} jobs healthy · {tb_count} tracebacks · {reject_cell} in log tail_"

    # Degraded PG liveness: the DSN is missing or PG was unreachable, so the
    # PG-monitored jobs (memex-sync, agent-review, renderer) can't be checked.
    degraded = [r for r in reports if r.pg and r.pg_status == "degraded"]
    degraded_line = ""
    if degraded:
        names = ", ".join(r.name for r in degraded)
        degraded_line = (
            f"_⚠️ PG liveness unavailable (no {PG_DSN_ENV} or psql) — {names} "
            f"shown as unknown; log/marker jobs unaffected._"
        )

    rows = ["| job | last run | latest result |",
            "|---|---|---|"]
    for r in reports:
        if r.skipped_reason:
            rows.append(f"| {r.name} | — | _{r.skipped_reason}_ |")
            continue
        if r.pg:
            rows.append(f"| {r.name} | {_pg_run_cell(r)} | {_pg_result_cell(r)} |")
            continue
        if not r.fired:
            crashed_suffix = " (crashed)" if r.tracebacks else ""
            fire_cell = f"❌ never{crashed_suffix}" if r.fired_at_pt is None else f"❌ last: {r.fired_at_pt}{crashed_suffix}"
        elif r.fired_at_pt == "now":
            fire_cell = "✓ now (this run)"
        else:
            crashed_suffix = " (crashed)" if r.tracebacks else ""
            fire_cell = f"✓ {r.fired_at_pt} PT{crashed_suffix}"
        if r.section_present is None:
            section_cell = "—"
        elif not r.section_present:
            section_cell = "❌ missing"
        elif r.section_lines is None:
            section_cell = f"_{r.section_note}_"
        else:
            note = f" ({r.section_note})" if r.section_note else ""
            section_cell = f"✓ {r.section_lines} lines{note}"
        rows.append(f"| {r.name} | {fire_cell} | {section_cell} |")

    # Format traceback details at the bottom
    diag_lines = []
    if tracebacks:
        counts = {}
        for tb in tracebacks:
            key = (tb["tool"], tb["summary"])
            counts[key] = counts.get(key, 0) + 1
            
        diag_lines.append("")
        diag_lines.append("### Tracebacks in log tail")
        for (tool, summary_str), count in sorted(counts.items()):
            count_str = f" ({count}x)" if count > 1 else ""
            diag_lines.append(f"- **{tool}**: `{summary_str}`{count_str}")

    last_present, gaps = self_liveness
    parts = [
        f"## auto-review doctor — {today_pt.isoformat()}",
        "",
        summary,
    ]
    if degraded_line:
        parts += ["", degraded_line]
    parts += [
        "",
        format_self_liveness(today_pt, last_present, gaps),
        "",
        f"_reporting on yesterday's check-in: `journal/checkins/{yesterday.isoformat()}.md`_",
        "",
        *rows,
    ]
    if diag_lines:
        parts.extend(diag_lines)
    parts.extend([
        "",
        f"<!-- auto-review-doctor:daily={today_pt.isoformat()} generated_at={now_utc} -->",
    ])
    
    return "\n".join(parts) + "\n"


def strip_and_replace(text: str, new_section: str) -> str:
    om = DOCTOR_MARKER_OPEN.search(text)
    cm = DOCTOR_MARKER_CLOSE.search(text)
    if om and cm and om.start() < cm.start():
        # Replace existing section; preserve trailing newline behavior.
        before = text[:om.start()]
        after = text[cm.end():]
        if after.startswith("\n"):
            after = after.lstrip("\n")
            sep = "\n"
        else:
            sep = ""
        return before + new_section + sep + after
    # Append. Ensure separation from prior content.
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    return text + new_section


def ensure_checkin(checkin_path: Path, date: dt.date) -> str:
    if checkin_path.exists():
        return checkin_path.read_text(encoding="utf-8")
    # Match the convention from existing check-in notes.
    iso = date.isoformat()
    return (
        f"---\n"
        f"created: '{iso}'\n"
        f"date: '{iso}'\n"
        f"tags:\n"
        f"- journal/checkin\n"
        f"---\n"
        f"\n"
        f"# check-in — {iso}\n"
        f"\n"
    )


def iso_week_label(date: dt.date) -> str:
    iso_year, iso_week, _ = date.isocalendar()
    return f"{iso_year}-W{iso_week:02d}"


def reported_week_label(today: dt.date) -> str:
    """ISO-week label the Monday weekly recap covers: `last-week` relative to the
    run day, matching `vault-review run-weekly last-week`. On Monday this is the
    Mon–Sun week that just ended."""
    return iso_week_label(today - dt.timedelta(weeks=1))


def weekly_note_path(vault: Path, week_label: str) -> Path:
    return vault / "journal" / "weekly" / f"{week_label}.md"


def checkin_path(checkin_dir: Path, date: dt.date) -> Path:
    """Path to a daily check-in note, nested by month (auto-review-d4c).

    Layout: <checkin_dir>/YYYY/MM/YYYY-MM-DD.md. The filename keeps the full
    date so markers/links/date-keys are unchanged — only the directory nests.
    Mirrors the sibling tools' Settings.checkin_path so the doctor reads what
    they write.
    """
    return checkin_dir / f"{date:%Y}" / f"{date:%m}" / f"{date.isoformat()}.md"


def doctor_self_liveness(
    checkin_dir: Path, today_pt: dt.date, window_days: int = SELF_LIVENESS_WINDOW
) -> tuple[dt.date | None, list[dt.date]]:
    """Scan the prior `window_days` check-ins for the doctor's OWN daily marker.

    Returns (last_present_date, gap_dates) over [today-window .. today-1]. Today
    is excluded — this very run writes today's section. `gap_dates` are missing
    days that fall *after* the doctor's earliest seen run in the window, so we
    don't flag days before the doctor existed. This catches the motivating
    failure — consecutive silent misses — the moment the doctor runs again, with
    no side-channel or extra cron.
    """
    present: list[dt.date] = []
    missing: list[dt.date] = []
    for delta in range(1, window_days + 1):
        d = today_pt - dt.timedelta(days=delta)
        path = checkin_path(checkin_dir, d)
        marker = re.compile(rf"auto-review-doctor:daily={re.escape(d.isoformat())}\b")
        if path.exists() and marker.search(path.read_text(encoding="utf-8")):
            present.append(d)
        else:
            missing.append(d)
    if not present:
        return None, []
    earliest = min(present)
    gaps = sorted(d for d in missing if d > earliest)
    return max(present), gaps


def render_moving_pieces(today_pt: dt.date, registry: list[Job] = JOBS) -> str:
    """Render the periodic-process registry as a standalone markdown dashboard.

    Generated from the same JOBS registry the doctor uses for liveness, so the
    dashboard cannot drift from what's actually monitored. The 'monitored?'
    column makes coverage gaps (unmonitored moving pieces) visible at a glance.
    """
    now_utc = dt.datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    monitored = [j for j in registry if j.monitored]
    lines = [
        "# Moving pieces — auto-review periodic-process registry",
        "",
        f"_Generated by auto-review doctor on {today_pt.isoformat()} — DO NOT EDIT BY HAND._",
        "_Source of truth: the `JOBS` registry in `doctor/auto-review-doctor`; "
        "any stack change must update it (see AGENTS.md)._",
        f"_{len(monitored)}/{len(registry)} pieces are liveness-monitored by the doctor; "
        "⚠️ rows are coverage gaps._",
        "",
        "| process | host | cadence | writes | monitored? |",
        "|---|---|---|---|---|",
    ]
    for j in registry:
        if j.monitored:
            mon = "✅ self" if j.marker_tool == "auto-review-doctor" else "✅"
        else:
            mon = "⚠️ no"
        lines.append(f"| {j.name} | {j.host} | {j.cadence} | {j.writes} | {mon} |")
    lines += ["", f"<!-- auto-review-doctor:moving-pieces generated_at={now_utc} -->", ""]
    return "\n".join(lines) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description="auto-review doctor v0")
    ap.add_argument("--log", type=Path, default=DEFAULT_LOG, help=f"cron.log path (default: {DEFAULT_LOG})")
    ap.add_argument("--vault", type=Path, default=DEFAULT_VAULT, help=f"vault root (default: {DEFAULT_VAULT})")
    ap.add_argument("--date", type=str, default=None, help="override today (YYYY-MM-DD, PT)")
    ap.add_argument("--tail", type=int, default=TAIL_LINES, help=f"log lines to scan (default: {TAIL_LINES})")
    ap.add_argument("--dry-run", action="store_true", help="don't write; print to stdout")
    ap.add_argument("--print", action="store_true", help="also print to stdout when writing")
    args = ap.parse_args()

    today_pt = (
        dt.date.fromisoformat(args.date)
        if args.date
        else dt.datetime.now(PT).date()
    )
    yesterday_pt = today_pt - dt.timedelta(days=1)

    log_lines = tail_lines(args.log, args.tail)
    checkin_dir = args.vault / "journal" / "checkins"
    yesterday_path = checkin_path(checkin_dir, yesterday_pt)
    today_path = checkin_path(checkin_dir, today_pt)
    weekly_path = weekly_note_path(args.vault, reported_week_label(today_pt))

    yesterday_text = yesterday_path.read_text(encoding="utf-8") if yesterday_path.exists() else ""
    weekly_text = weekly_path.read_text(encoding="utf-8") if weekly_path.exists() else ""

    tracebacks = find_tracebacks(log_lines)
    pg_runs = query_latest_runs(os.environ.get(PG_DSN_ENV))
    reports = assess_jobs(log_lines, today_pt, yesterday_text, weekly_text, tracebacks, pg_runs=pg_runs)
    push_rejections = count_push_rejections(log_lines)
    self_liveness = doctor_self_liveness(checkin_dir, today_pt)
    section = render_section(today_pt, reports, tracebacks, push_rejections, self_liveness)
    moving_pieces = render_moving_pieces(today_pt)

    if args.dry_run:
        sys.stdout.write(section)
        sys.stdout.write("\n----- reference/auto-review/moving-pieces.md -----\n")
        sys.stdout.write(moving_pieces)
        return 0

    today_text = ensure_checkin(today_path, today_pt)
    new_text = strip_and_replace(today_text, section)
    today_path.parent.mkdir(parents=True, exist_ok=True)
    today_path.write_text(new_text, encoding="utf-8")

    # Regenerate the moving-pieces registry dashboard (whole-file rewrite — the
    # registry is the source of truth, so this is an overwrite, not a merge).
    mp_path = args.vault / "reference" / "auto-review" / "moving-pieces.md"
    mp_path.parent.mkdir(parents=True, exist_ok=True)
    mp_path.write_text(moving_pieces, encoding="utf-8")

    if args.print:
        sys.stdout.write(section)
    print(f"auto-review-doctor: wrote section → {today_path}", file=sys.stderr)
    print(f"auto-review-doctor: wrote registry → {mp_path}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
