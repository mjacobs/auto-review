DEFAULT_LOG = Path.home() / ".local/state/auto-review/cron.log"
DEFAULT_VAULT = Path.home() / "vault"
TAIL_LINES = 1000

# ── PG liveness (auto-review-hg6.8) ──
# The doctor reads ops.job_runs for the PG-writer jobs (memex-sync, agent-review,
# the renderer) instead of cron.log+markers, which those jobs no longer emit. PG
# access is OPTIONAL: a stdlib `psql -At` subprocess (the doctor stays dependency-
# free — no psycopg), degrading to the log/marker path when there's no DSN or psql.
PG_DSN_ENV = "AUTO_REVIEW_DOCTOR_PG_DSN"
PSQL_TIMEOUT_S = 10
# One latest row per job_name. finished_at is rendered as the same UTC "…Z" ISO
# string parse_utc_iso() already understands; cost_usd as plain text ('' if NULL).
# The summary jsonb is selected too (auto-review-byp): the agent-review run's
# summary carries {"reports": N, "dates": [...]} — N is how many daily_reports
# rows that run persisted. The doctor reads `reports` to tell a real report day
# (reports>=1) from a quiet zero-session day (reports=0, identical placeholder
# text) when asserting the rendered artifact. Selecting it here EXTENDS the one
# existing liveness query rather than adding a second round-trip. A jsonb::text
# cast emits compact JSON (no literal tabs), so it stays one -F'\t' field.
SQL_LATEST_RUNS = (
    "SELECT DISTINCT ON (job_name) job_name, "
    "to_char(finished_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), "
    "status, coalesce(cost_usd::text, ''), coalesce(summary::text, '{}') "
    "FROM ops.job_runs ORDER BY job_name, finished_at DESC"
)

# ── PG job registry (auto-review-6mf.1) ──
# The moving-pieces registry (name/host/cadence/writes/monitored + the flat
# liveness window) is now sourced from ops.jobs, NOT a hardcoded JOBS list: those
# rows name internal hosts/schedules — content that must stay out of this PUBLIC
# repo (design: docs/superpowers/specs/2026-06-30-jobs-registry-pg.md). Only
# live (non-retired) rows; monitored first so the dashboard leads with watched
# jobs. expected_interval is emitted as decimal HOURS (0 when NULL) so the flat
# PG-liveness window rides along without a second round-trip. Read via the same
# `psql -At` subprocess seam as SQL_LATEST_RUNS (keeps the doctor dependency-free).
SQL_REGISTRY = (
    "SELECT name, host, cadence, writes, monitored, "
    "coalesce(extract(epoch from expected_interval)/3600.0, 0) "
    "FROM ops.jobs WHERE retired_at IS NULL ORDER BY monitored DESC, name"
)

# ── PG self-row write: the external dead-man substrate (auto-review-02w) ──
# g52's in-band self-liveness can't fire while the doctor is FULLY down (nothing
# runs to report — the watcher-flaw). So the doctor ALSO records its own
# ops.job_runs row at the end of every run, making "latest doctor row age" a
# substrate any INDEPENDENT process with PG read access can check in one line:
#   SELECT now() - max(finished_at) FROM ops.job_runs WHERE job_name = 'auto-review-doctor';
# The job_name is registered in ops.jobs by db/migrations/0009 (the job_runs FK
# requires it); the auto_review_doctor role already holds INSERT (0005).
DOCTOR_JOB_NAME = "auto-review-doctor"
# finished_at defaults to now(); started_at is supplied (a now() default would
# fake durations — see ops.job_runs). cost_usd is NULL: the doctor does no LLM
# work (the renderer's runlog precedent). Values are injected via psql variables
# (-v ... + :'name') which substitute as properly-quoted SQL string literals, so
# the statement is injection-safe even though we control every value.
SQL_INSERT_DOCTOR_RUN = (
    "INSERT INTO ops.job_runs (job_name, host, started_at, finished_at, status, cost_usd, summary) "
    "VALUES (:'job_name', :'host', :'started_at', now(), :'status', NULL, :'summary'::jsonb)"
)

