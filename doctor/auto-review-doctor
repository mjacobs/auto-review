def tail_lines(path: Path, n: int) -> list[str]:
    if not path.exists():
        return []
    # Stdlib-friendly tail: read whole file. cron.log is ~6k lines today;
    # rotation work (auto-review-75t) is tracked separately. Good enough for v0.
    with path.open("r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    return lines[-n:]


def parse_utc_iso(s: str) -> dt.datetime:
    # "2026-05-18T03:01:01Z"
    return dt.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)


@dataclass(frozen=True)
class RunRow:
    """One latest ops.job_runs row, for a PG-monitored job's liveness."""
    job_name: str
    finished_at: dt.datetime     # UTC
    status: str                  # 'ok' | 'error'
    cost_usd: float | None
    # The run's summary jsonb, parsed (auto-review-byp). For agent-review this
    # carries {"reports": N, "dates": [...]}: `reports` is how many daily_reports
    # rows the run persisted (0 on a quiet zero-session day), `dates` the days it
    # covered. The artifact check (assess_agent_artifact) uses these to separate a
    # real report from a legitimately-empty day. {} when absent/unparseable.
    summary: dict = field(default_factory=dict)


def _rows_to_runmap(rows: list[list[str]]) -> dict[str, RunRow]:
    """Parse psql `-At -F\\t` rows into {job_name: RunRow}. Malformed rows are
    skipped rather than fatal — a parse hiccup must not blind the whole report."""
    out: dict[str, RunRow] = {}
    for r in rows:
        if len(r) < 4:
            continue
        job_name, finished, status, cost = r[0], r[1], r[2], r[3]
        try:
            ts = parse_utc_iso(finished)
        except ValueError:
            continue
        cost_usd: float | None = None
        if cost not in ("", None):
            try:
                cost_usd = float(cost)
            except ValueError:
                cost_usd = None
        # summary is the 5th column (added auto-review-byp); older queries / rows
        # without it parse to an empty dict rather than failing.
        summary: dict = {}
        if len(r) >= 5 and r[4]:
            try:
                parsed = json.loads(r[4])
                if isinstance(parsed, dict):
                    summary = parsed
            except (ValueError, TypeError):
                summary = {}
        out[job_name] = RunRow(
            job_name=job_name, finished_at=ts, status=status,
            cost_usd=cost_usd, summary=summary,
        )
    return out


def query_latest_runs(dsn: str | None) -> dict[str, RunRow] | None:
    """Latest ops.job_runs row per job_name via a `psql -At` subprocess.

    Returns None — signalling "degrade to the log/marker path" — when there's no
    DSN, psql isn't on PATH, or the query fails/times out, so the doctor still
    runs on a box without PG. Keeping this a subprocess (not psycopg) is what lets
    the doctor stay a single stdlib-only file.
    """
    if not dsn or not shutil.which("psql"):
        return None
    conn_arg, pg_env = _psql_conn(dsn)
    try:
        proc = subprocess.run(
            ["psql", conn_arg, "-At", "-F", "\t", "-v", "ON_ERROR_STOP=1", "-c", SQL_LATEST_RUNS],
            capture_output=True, text=True, timeout=PSQL_TIMEOUT_S,
            env={**os.environ, "PGCONNECT_TIMEOUT": "8", **pg_env},
        )
    except (subprocess.SubprocessError, OSError):
        return None
    if proc.returncode != 0:
        return None
    rows = [line.split("\t") for line in proc.stdout.splitlines() if line.strip()]
    return _rows_to_runmap(rows)


def _rows_to_registry(rows: list[list[str]]) -> list[JobRow]:
    """Parse psql `-At -F\\t` rows from SQL_REGISTRY into JobRow objects. `monitored`
    arrives as psql's boolean text ('t'/'f'); the interval column is decimal hours.
    Malformed rows are skipped rather than fatal — a parse hiccup on one row must
    not blank the whole registry."""
    out: list[JobRow] = []
    for r in rows:
        if len(r) < 6:
            continue
        name, host, cadence, writes, monitored, interval = r[0], r[1], r[2], r[3], r[4], r[5]
        try:
            hours = float(interval) if interval not in ("", None) else 0.0
        except ValueError:
            hours = 0.0
        out.append(JobRow(
            name=name, host=host, cadence=cadence, writes=writes,
            monitored=(monitored == "t"), expected_interval_hours=hours,
        ))
    return out


def query_registry(dsn: str | None) -> list[JobRow] | None:
    """The live job registry (ops.jobs) via a `psql -At` subprocess (auto-review-6mf.1).

    Returns None — signalling DEGRADED (skip the moving-pieces projection, don't
    fabricate it; Decision 2) — when there's no DSN, psql isn't on PATH, or the
    query fails/times out. Mirrors query_latest_runs so the doctor stays a single
    stdlib-only file and never crashes on a PG-less box.
    """
    if not dsn or not shutil.which("psql"):
        return None
    conn_arg, pg_env = _psql_conn(dsn)
    try:
        proc = subprocess.run(
            ["psql", conn_arg, "-At", "-F", "\t", "-v", "ON_ERROR_STOP=1", "-c", SQL_REGISTRY],
            capture_output=True, text=True, timeout=PSQL_TIMEOUT_S,
            env={**os.environ, "PGCONNECT_TIMEOUT": "8", **pg_env},
        )
    except (subprocess.SubprocessError, OSError):
        return None
    if proc.returncode != 0:
        return None
    rows = [line.split("\t") for line in proc.stdout.splitlines() if line.strip()]
    return _rows_to_registry(rows)


def _psql_conn(dsn: str) -> tuple[str, dict[str, str]]:
    """Split a Postgres conninfo into (arg_for_psql, extra_env) that keeps any
    PASSWORD out of psql's argv (auto-review-02w, roborev review job 129).

    A password on the command line is world-readable via /proc/<pid>/cmdline, so
    only the password is moved to PGPASSWORD (env → /proc/<pid>/environ, mode 0400,
    owner/root only); host/user/db (not secrets) stay in the connection arg.
    Defensive by design: handles the URI and keyword conninfo forms, and on
    ANYTHING it can't confidently parse it returns the DSN unchanged — this fix
    can only relocate a clearly-extractable password, never break a working
    connection. A .pgpass-backed DSN (no embedded password) is a clean no-op.
    """
    # URI form: postgres[ql]://user[:PASSWORD]@host…[?…&password=…]. libpq accepts
    # the password BOTH in userinfo AND as a ?password= query param (incl. the
    # Unix-socket `postgresql:///db?host=/run/pg&password=…` form, which has no
    # userinfo), so strip it from both (roborev review job 138).
    if re.match(r"(?i)postgres(?:ql)?://", dsn.strip()):
        parts = urllib.parse.urlsplit(dsn.strip())
        netloc, query, pw = parts.netloc, parts.query, None
        if parts.password is not None and "@" in netloc:
            userinfo, hostinfo = netloc.rsplit("@", 1)
            user = userinfo.split(":", 1)[0]
            netloc = f"{user}@{hostinfo}" if user else hostinfo  # hostinfo verbatim (IPv6/port)
            pw = urllib.parse.unquote(parts.password)
        if query:
            # Raw-split, NOT parse_qsl: a Postgres URI query is RFC3986 (a literal
            # '+' is a '+'), whereas parse_qsl form-decodes '+'→space and would
            # corrupt the password and any other param (roborev review job 144).
            # Non-password segments are kept verbatim; only the password is
            # percent-decoded (urllib.parse.unquote leaves '+' literal).
            segs = query.split("&")
            pw_segs = [s for s in segs if s.split("=", 1)[0].lower() == "password"]
            if pw_segs:
                last = pw_segs[-1]  # libpq: last password wins
                pw = urllib.parse.unquote(last.split("=", 1)[1]) if "=" in last else ""
                query = "&".join(s for s in segs if s.split("=", 1)[0].lower() != "password")
        if pw is None:
            return dsn, {}
        sanitized = urllib.parse.urlunsplit((parts.scheme, netloc, parts.path, query, parts.fragment))
        return sanitized, {"PGPASSWORD": pw}
    # keyword form: host=... password=secret (or password='se cret', backslash-escaped).
    # Strip EVERY password= assignment and take the LAST value — libpq uses the
    # last when a keyword repeats, so removing only the first would leave the
    # effective password in argv (roborev review job 147). Extra whitespace left
    # between the remaining keywords is harmless to libpq.
    pat = re.compile(r"(?ix) (?:^|\s) password \s*=\s* (?: '((?:[^'\\]|\\.)*)' | (\S+) )")
    matches = list(pat.finditer(dsn))
    if not matches:
        return dsn, {}
    last = matches[-1]
    pw = last.group(1).replace("\\'", "'").replace("\\\\", "\\") if last.group(1) is not None else last.group(2)
    return pat.sub(" ", dsn).strip(), {"PGPASSWORD": pw}


def record_doctor_run(
    dsn: str | None,
    *,
    started_at: dt.datetime,
    status: str,
    summary: dict,
) -> bool:
    """Append ONE ops.job_runs row for the doctor itself, best-effort.

    This is the EXTERNAL dead-man substrate (auto-review-02w): a row the doctor
    leaves behind each run so an independent process can detect the doctor being
    fully down (a case g52's in-band check structurally can't catch). Mirrors the
    read path: a stdlib `psql` subprocess (NOT psycopg), degrading silently to a
    no-op when there's no DSN or psql isn't on PATH. Write errors are SWALLOWED —
    a failed self-row must never crash the doctor's primary health output (the FK
    isn't applied yet, the DB is down, etc.). Returns True iff a row was written.

    Values go through psql `-v name=value` variables referenced as :'name', which
    substitute as properly-quoted SQL string literals — injection-safe even
    though every value here is the doctor's own. started_at is rendered as the
    same UTC "…Z" ISO form parse_utc_iso()/the query use; cost_usd is NULL (the
    doctor does no LLM work — the renderer runlog precedent).
    """
    if not dsn or not shutil.which("psql"):
        return False
    started_iso = started_at.astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    conn_arg, pg_env = _psql_conn(dsn)
    try:
        proc = subprocess.run(
            [
                "psql", conn_arg, "-At", "-q", "-v", "ON_ERROR_STOP=1",
                "-v", f"job_name={DOCTOR_JOB_NAME}",
                "-v", f"host={socket.gethostname()}",
                "-v", f"started_at={started_iso}",
                "-v", f"status={status}",
                "-v", f"summary={json.dumps(summary, separators=(',', ':'))}",
                "-c", SQL_INSERT_DOCTOR_RUN,
            ],
            capture_output=True, text=True, timeout=PSQL_TIMEOUT_S,
            env={**os.environ, "PGCONNECT_TIMEOUT": "8", **pg_env},
        )
    except (subprocess.SubprocessError, OSError):
        return False
    return proc.returncode == 0


def assess_pg_job(
    job: Job, today_pt: dt.date, pg_runs: dict[str, RunRow] | None, now_utc: dt.datetime
) -> JobReport:
    """Build a JobReport for a PG-monitored job from the latest-runs map.

    pg_runs is None when PG is unreachable (degraded: liveness unknown); a job
    absent from the map has never recorded a run; otherwise liveness is whether
    the latest row is younger than the job's window.
    """
    base = dict(
        name=job.name, expected_hhmm=job.cadence, section_present=None,
        section_lines=None, section_note="", skipped_reason=None, pg=True,
    )
    if pg_runs is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status="degraded", **base)
    row = pg_runs.get(job.pg_job_name)
    if row is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status=None, **base)
    age_h = (now_utc - row.finished_at).total_seconds() / 3600.0
    fresh = age_h <= job.pg_interval_hours
    ts_pt = row.finished_at.astimezone(PT)
    fired_at = ts_pt.strftime("%H:%M") if ts_pt.date() == today_pt else f"({ts_pt.date().isoformat()})"
    cost = f"${row.cost_usd:.4f}" if row.cost_usd is not None else None
    return JobReport(
        fired=fresh, fired_at_pt=fired_at, pg_status=row.status,
        pg_cost=cost, pg_overdue=not fresh, **base,
    )


def most_recent_weekly_fire(job: Job, now_utc: dt.datetime) -> dt.datetime:
    """The most-recent EXPECTED weekly fire (UTC) at-or-before ``now_utc``.

    The weekly cron fires at ``pg_weekly_hhmm`` PT on ``pg_weekly_dow`` (Monday).
    We compute the fire instant in PT, then convert to UTC for comparison with
    the row's (UTC) finished_at. "At-or-before now" so that AFTER this week's fire
    has passed we measure against THIS week's expected run, and before it we
    measure against LAST week's — which is what makes the check both per-week
    (a real miss surfaces) and free of the pre-fire-Monday false-positive.
    """
    hh, mm = (int(x) for x in job.pg_weekly_hhmm.split(":"))
    now_pt = now_utc.astimezone(PT)
    # Walk back to the most recent scheduled weekday at hh:mm that is <= now_pt.
    days_since_dow = (now_pt.weekday() - job.pg_weekly_dow) % 7
    fire_date = now_pt.date() - dt.timedelta(days=days_since_dow)
    fire_pt = dt.datetime.combine(fire_date, dt.time(hh, mm), tzinfo=PT)
    if fire_pt > now_pt:
        # Today IS the scheduled day but we're before the fire time → last week's.
        fire_pt -= dt.timedelta(weeks=1)
    return fire_pt.astimezone(UTC)


def assess_pg_weekly_job(
    job: Job, today_pt: dt.date, pg_runs: dict[str, RunRow] | None, now_utc: dt.datetime
) -> JobReport:
    """Schedule-aware liveness for a weekly PG job (auto-review-2vv).

    A flat age window can't express a weekly cadence: an 8-day window stays green
    for ~8 days after a real miss, and a tight window false-positives every Monday
    before the fire (the hg6.12 BUG2). Instead: the job is FRESH unless the
    most-recent expected Monday fire (+grace) has passed without a row finishing
    at-or-after that fire. So:
      * before this Monday's fire → measured against LAST week's fire, which a
        normal run already satisfied → green (no BUG2 false-positive);
      * after the fire+grace with no fresh row → overdue (a real miss surfaces,
        and stays surfaced for the whole week, not silently self-clearing).
    """
    base = dict(
        name=job.name, expected_hhmm=job.cadence, section_present=None,
        section_lines=None, section_note="", skipped_reason=None, pg=True,
    )
    if pg_runs is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status="degraded", **base)
    row = pg_runs.get(job.pg_job_name)
    if row is None:
        return JobReport(fired=False, fired_at_pt=None, pg_status=None, **base)

    expected_fire = most_recent_weekly_fire(job, now_utc)
    deadline = expected_fire + dt.timedelta(hours=job.pg_grace_hours)
    # Fresh if the latest row covers the most-recent expected fire, OR we haven't
    # yet reached that fire's grace deadline (the run still has time to land).
    fresh = row.finished_at >= expected_fire or now_utc < deadline

    ts_pt = row.finished_at.astimezone(PT)
    fired_at = ts_pt.strftime("%H:%M") if ts_pt.date() == today_pt else f"({ts_pt.date().isoformat()})"
    cost = f"${row.cost_usd:.4f}" if row.cost_usd is not None else None
    return JobReport(
        fired=fresh, fired_at_pt=fired_at, pg_status=row.status,
        pg_cost=cost, pg_overdue=not fresh, **base,
    )


def latest_match(lines: list[str], pattern: re.Pattern[str]) -> tuple[str, dt.datetime] | None:
    last: tuple[str, dt.datetime] | None = None
    for line in lines:
        m = pattern.search(line)
        if m:
            try:
                last = (line.rstrip(), parse_utc_iso(m.group(1)))
            except ValueError:
                continue
    return last


def section_body(text: str, tool: str, marker_key: str, label: str) -> str | None:
    """The body text between a section's `## {tool} …` heading and its close marker.

    Returns None when the close marker is absent (section not present at all), or
    when the close marker is present but the opening heading isn't (the malformed
    "open heading missing" case `section_info` flags). The heading line and the
    close marker themselves are excluded — only the in-between content.

    Shared by `section_info` (line count / capture note) and the artifact check
    (`assess_agent_artifact`), so both extract the SAME bytes from the same note.
    """
    close_marker = re.compile(
        rf"^<!--\s*{re.escape(tool)}:{re.escape(marker_key)}={re.escape(label)}\s+generated_at=\S+\s*-->$",
        re.MULTILINE,
    )
    cm = close_marker.search(text)
    if not cm:
        return None
    # The close marker already pins tool+kind+label, so the section start is just
    # the nearest `## {tool} …` heading before it. Don't key the heading on the
    # date — weekly headings are keyed on the week, not a daily date. Consume the
    # whole heading line so its text stays out of the body line count.
    # Hyphens in the tool name may render as spaces in the heading (e.g. marker
    # `auto-review-doctor` → heading `## auto-review doctor`), so match either.
    tool_pat = re.escape(tool).replace(r"\-", "[- ]")
    open_marker = re.compile(rf"^##\s+{tool_pat}\b[^\n]*$", re.MULTILINE)
    om = None
    for m in open_marker.finditer(text):
        if m.start() < cm.start():
            om = m
    if not om:
        return None
    return text[om.end():cm.start()]


def section_info(text: str, tool: str, marker_key: str, label: str) -> tuple[bool, int, str]:
    """Find `<!-- {tool}:{marker_key}={label} ... -->` and its matching `## {tool} …` heading.

    `marker_key`/`label` are "daily"/"YYYY-MM-DD" or "weekly"/"YYYY-W##", matching the
    marker each sibling emits (see vault-review's vault.py).

    Returns (present, line_count_inside, note).
    """
    # Distinguish "no close marker" (absent) from "close marker but no heading"
    # (present-but-malformed) — section_body() returns None for both, so re-check
    # the close marker to keep section_info's two distinct return shapes.
    body = section_body(text, tool, marker_key, label)
    if body is None:
        close_marker = re.compile(
            rf"^<!--\s*{re.escape(tool)}:{re.escape(marker_key)}={re.escape(label)}\s+generated_at=\S+\s*-->$",
            re.MULTILINE,
        )
        if close_marker.search(text):
            return (True, 0, "(close marker found, open heading missing)")
        return (False, 0, "")
    line_count = sum(1 for line in body.splitlines() if line.strip())
    note = ""
    if "0 captures" in body or "no captures in window" in body:
        note = "0 captures"
    return (True, line_count, note)


def renderer_bracket_body(text: str, date: dt.date) -> str | None:
    """The text inside the renderer's begin/end bracket for ``date``.

    The new renderer (ADR-002) is the SINGLE writer of the agent-review section
    and wraps ALL its sections in one contiguous pair (renderer/src/
    checkin_renderer/compose.py):
      begin: ``<!-- checkin-renderer:begin daily={D} -->``   (no generated_at)
      end:   ``<!-- checkin-renderer:end daily={D} generated_at={ts} -->``
    It also STRIPS the legacy per-section ``agent-review:report_date=…`` marker
    (sections/agent.py → _LEGACY_MARKER_RE), so there is NO per-section marker to
    key on — the bracket is the only structural anchor.

    Returns the bytes between the begin and end markers (markers excluded), or
    None when the bracket for ``date`` is absent — the renderer didn't run /
    nothing to assert here (renderer liveness is separately PG-monitored).
    """
    iso = re.escape(date.isoformat())
    begin = re.compile(rf"^<!--\s*checkin-renderer:begin\s+daily={iso}\s*-->$", re.MULTILINE)
    end = re.compile(
        rf"^<!--\s*checkin-renderer:end\s+daily={iso}\s+generated_at=\S+\s*-->$",
        re.MULTILINE,
    )
    bm = begin.search(text)
    if not bm:
        return None
    em = end.search(text, bm.end())
    if not em:
        return None
    return text[bm.end():em.start()]


def assess_agent_artifact(
    yesterday_text: str,
    yesterday_pt: dt.date,
    pg_runs: dict[str, RunRow] | None,
) -> str | None:
    """Warn when note D's RENDERED agent-review section is the placeholder while a
    real report exists for D (auto-review-byp).

    The motivating defect (OMG-002, 2026-06-18): the doctor reports agent-review
    'ok' off the producer's ops.job_runs STATUS, but the consumer ARTIFACT — the
    rendered note — still held the `_no agent-review report row for D_` placeholder.
    Producer status is liveness, not correctness; this asserts the artifact.

    Extraction targets the REAL renderer bracket (ADR-002 / renderer_bracket_body):
    the renderer is the single writer and emits one ``checkin-renderer:begin/end
    daily=D`` pair around its sections, stripping any legacy per-section marker. We
    scope the placeholder test to that bracket — robust because the placeholder is
    agent-review-specific and date-pinned (``_no agent-review report row for D_``).
    A SUCCESSFUL agent-review heading is keyed to the report's generated-at
    (e.g. ``## agent-review — 2026-06-20 00:17``), NOT to D, so we do NOT locate
    the section by matching D in a heading. No bracket → return None (renderer
    didn't run / nothing to assert; renderer liveness is separately PG-monitored).

    CRITICAL quiet-day guard: a legitimate zero-session day renders the IDENTICAL
    placeholder string (the producer records status='ok' with reports=0 and writes
    NO daily_reports[D] row). So the warning must NOT key on note text alone. It
    fires only when BOTH:
      (1) the placeholder is present in note D's renderer bracket, AND
      (2) a real report exists for D — the agent-review run's summary reports `>= 1`
          report persisted for a run that covered D.
    On a quiet day (placeholder present, reports=0) it stays silent → doctor green.
    PG unreachable (pg_runs is None) → no signal → stay silent (don't false-alarm).

    Returns the warning markdown line, or None when there's nothing to flag.
    """
    body = renderer_bracket_body(yesterday_text, yesterday_pt)
    placeholder = f"{AGENT_PLACEHOLDER_PREFIX}{yesterday_pt.isoformat()}_"
    if body is None or placeholder not in body:
        return None  # no renderer bracket, or it holds a real report — fine
    if pg_runs is None:
        return None  # degraded: can't tell a defect from a quiet day → don't guess
    row = pg_runs.get("agent-review")
    if row is None:
        return None  # producer never ran for us to compare against
    if not _producer_reported_report_for(row, yesterday_pt):
        return None  # quiet day: placeholder is CORRECT (no report row exists) → green
    return (
        f"_⚠️ agent-review artifact mismatch: note for {yesterday_pt.isoformat()} shows the "
        f"`{AGENT_PLACEHOLDER_PREFIX.strip('_').strip()} …` placeholder, but the producer "
        f"persisted a report for that day (job_runs reports≥1) — the rendered note is stale "
        f"(re-run the renderer; see the hg6.11 catch-up)._"
    )


def _producer_reported_report_for(row: RunRow, date: dt.date) -> bool:
    """True only when the agent-review run-row UNAMBIGUOUSLY persisted a report for
    exactly ``date`` — a single-date run covering D that persisted ≥1 report.

    Reads the run's summary {"reports": N, "dates": [...]} (agent-review's
    cli._run_summary). The catch (roborev review, auto-review-byp): `dates` lists
    every date the run REQUESTED and `reports` is only an aggregate persisted
    count — neither attributes a report to a specific day. A multi-date backfill
    (e.g. `agent-review run 06-18..06-19`) that persisted 06-18 but left D=06-19
    quiet would, under a plain `D in dates` test, be misread as "D has a report"
    and false-positive D's CORRECT placeholder. So we assert ONLY on the
    unambiguous single-date shape `dates == [D]` with reports≥1 — the normal
    nightly run (one day, run the next morning). When we can't be certain (a
    multi-date run, or `dates` absent on an older row) we stay silent: the
    quiet-day guard's whole job is to never false-alarm a legitimately-empty day."""
    reports = row.summary.get("reports")
    if not isinstance(reports, int) or reports < 1:
        return False
    dates = row.summary.get("dates")
    return isinstance(dates, list) and dates == [date.isoformat()]


def find_tracebacks(lines: list[str]) -> list[dict[str, str]]:
    tracebacks = []
    n = len(lines)
    i = 0
    while i < n:
        if lines[i].startswith("Traceback (most recent call last):"):
            block_lines = [lines[i]]
            j = i + 1
            while j < n:
                if lines[j].startswith(" ") or lines[j].startswith("\t") or not lines[j].strip():
                    block_lines.append(lines[j])
                    j += 1
                else:
                    block_lines.append(lines[j])
                    j += 1
                    break
            
            file_path = None
            line_no = None
            for tbl in reversed(block_lines):
                m = re.search(r'File "([^"]+)", line (\d+)', tbl)
                if m:
                    file_path = m.group(1)
                    line_no = m.group(2)
                    break
            
            exc_line = block_lines[-1].strip() if block_lines else "UnknownError"
            
            tool = "other"
            if file_path:
                fp_lower = file_path.lower()
                if "vault-review" in fp_lower or "vault_review" in fp_lower:
                    tool = "vault-review"
                elif "memex-review" in fp_lower or "memex_review" in fp_lower:
                    tool = "memex-review"
                elif "agent-review" in fp_lower or "agent_review" in fp_lower:
                    tool = "agent-review"
                elif "doctor" in fp_lower or "auto-review-doctor" in fp_lower:
                    tool = "auto-review-doctor"
            
            exc_match = re.match(r'^([\w\.]+):\s*(.*)$', exc_line)
            if exc_match:
                exc_type = exc_match.group(1).split('.')[-1]
                exc_msg = exc_match.group(2)
                exc_summary = f"{exc_type}: {exc_msg}"
            else:
                exc_summary = exc_line
            
            loc = ""
            if file_path:
                loc = f" ({Path(file_path).name}:{line_no})"
            
            tracebacks.append({
                "tool": tool,
                "summary": f"{exc_summary}{loc}",
                "full_text": "".join(block_lines)
            })
            i = j
        else:
            i += 1
    return tracebacks


# git's per-ref rejection line, e.g. " ! [rejected]  main -> main (non-fast-forward)".
# One match == one rejected push. Healed automatically by the wrappers' rebase+retry
# (464110b), so this is a tripwire for the rare double-race, not a hard failure.
PUSH_REJECT = re.compile(r"!\s+\[rejected\].*\((?:non-fast-forward|fetch first)\)")


def count_push_rejections(lines: list[str]) -> int:
    return sum(1 for line in lines if PUSH_REJECT.search(line))


def assess_jobs(
    jobs: list[Job],
    log_lines: list[str],
    today_pt: dt.date,
    yesterday_checkin_text: str,
    tracebacks: list[dict[str, str]],
    pg_runs: dict[str, RunRow] | None = None,
    now_utc: dt.datetime | None = None,
) -> list[JobReport]:
    now_utc = now_utc or dt.datetime.now(UTC)
    reports: list[JobReport] = []
    for job in jobs:
        if not job.monitored:
            continue  # catalogued infra; liveness not checked (see moving-pieces doc)
        if job.pg_job_name:
            # PG-monitored: liveness is a fresh ops.job_runs row (hg6.8). The
            # weekly variant (auto-review-2vv) is schedule-aware rather than a flat
            # age window. pg_runs is None when PG is unreachable (degraded).
            if job.pg_weekly:
                reports.append(assess_pg_weekly_job(job, today_pt, pg_runs, now_utc))
            else:
                reports.append(assess_pg_job(job, today_pt, pg_runs, now_utc))
            continue
        name, hhmm, regex, sibling_tool, marker_key = (
            job.name, job.hhmm, job.commit_regex, job.marker_tool, job.marker_key,
        )
        if sibling_tool == "auto-review-doctor":
            # Self-row. We can't see our own commit in the log yet (it happens
            # after this script exits, in the cron wrapper), so "fired" reflects
            # this very run. But the section cell is now a REAL check of
            # yesterday's check-in for our own marker — that's our day-to-day
            # liveness signal. Multi-day gaps are surfaced separately by the
            # self-liveness line (see doctor_self_liveness).
            yday = today_pt - dt.timedelta(days=1)
            present, lines, note = section_info(
                yesterday_checkin_text, "auto-review-doctor", "daily", yday.isoformat()
            )
            reports.append(JobReport(
                name=name, expected_hhmm=hhmm, fired=True, fired_at_pt="now",
                section_present=present, section_lines=lines,
                section_note=note or "self", skipped_reason=None,
                tracebacks=[],
            ))
            continue
        match = latest_match(log_lines, regex)
        
        # Get tracebacks for this tool
        job_tracebacks = [tb["summary"] for tb in tracebacks if tb["tool"] == sibling_tool]
        
        if match is None:
            reports.append(JobReport(
                name=name, expected_hhmm=hhmm, fired=False, fired_at_pt=None,
                section_present=False, section_lines=0, section_note="",
                skipped_reason=None,
                tracebacks=job_tracebacks,
            ))
            continue
        _, ts_utc = match
        ts_pt = ts_utc.astimezone(PT)
        fired_today = ts_pt.date() == today_pt
        fired_at = ts_pt.strftime("%H:%M") if fired_today else f"({ts_pt.date().isoformat()})"
        yesterday = today_pt - dt.timedelta(days=1)
        present, lines, note = section_info(
            yesterday_checkin_text, sibling_tool, marker_key, yesterday.isoformat()
        )
        reports.append(JobReport(
            name=name, expected_hhmm=hhmm, fired=fired_today,
            fired_at_pt=fired_at, section_present=present, section_lines=lines,
            section_note=note, skipped_reason=None,
            tracebacks=job_tracebacks,
        ))
    return reports


def format_self_liveness(today_pt: dt.date, last_present: dt.date | None, gaps: list[dt.date]) -> str:
    """One-line in-band liveness of the doctor itself, over the lookback window."""
    if last_present is None:
        return (
            f"_⚠️ doctor self-liveness: no doctor section found in the last "
            f"{SELF_LIVENESS_WINDOW} days — has this job ever run?_"
        )
    days_ago = (today_pt - last_present).days
    ago = "yesterday" if days_ago == 1 else f"{days_ago}d ago"
    if gaps:
        missed = ", ".join(d.isoformat() for d in gaps)
        return (
            f"_⚠️ doctor self-liveness: last section {last_present.isoformat()} "
            f"({ago}) — missed run(s): {missed}_"
        )
    return f"_doctor self-liveness: last section {last_present.isoformat()} ({ago}) — no gaps_"


def _pg_run_cell(r: JobReport) -> str:
    """The 'last run' cell for a PG-monitored job."""
    if r.pg_status == "degraded":
        return "⚠️ unknown (no PG)"
    if r.fired_at_pt is None:          # no row ever recorded
        return "❌ never"
    when = f"{r.fired_at_pt} PT" if ":" in r.fired_at_pt else r.fired_at_pt
    if r.fired:                        # fresh: latest row within the window
        return f"✓ {when}"
    return f"❌ overdue (last {when})"  # a row exists but it's stale


def _pg_result_cell(r: JobReport) -> str:
    """The 'latest result' cell for a PG-monitored job: status + cost."""
    if r.pg_status in ("degraded", None):
        return "—"
    icon = "✓" if r.pg_status == "ok" else "⚠️"
    cell = f"{icon} {r.pg_status}"
    if r.pg_cost:
        cell += f" · {r.pg_cost}"
    return cell


def render_section(today_pt: dt.date, reports: list[JobReport], tracebacks: list[dict[str, str]], push_rejections: int, self_liveness: tuple[dt.date | None, list[dt.date]], agent_artifact_warning: str | None = None, registry_unavailable: str | None = None) -> str:
    now_utc = dt.datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    expected = [r for r in reports if r.skipped_reason is None]
    fired = [r for r in expected if r.fired]
    yesterday = today_pt - dt.timedelta(days=1)

    tb_count = len(tracebacks)
    reject_cell = f"{push_rejections} push rejections" if push_rejections == 0 else f"⚠️ {push_rejections} push rejections"
    summary = f"_{len(fired)}/{len(expected)} jobs healthy · {tb_count} tracebacks · {reject_cell} in log tail_"

    # Degraded PG liveness: the DSN is missing or PG was unreachable, so the
    # PG-monitored jobs (memex-sync, agent-review, renderer) can't be checked.
    degraded = [r for r in reports if r.pg and r.pg_status == "degraded"]
    degraded_line = ""
    if degraded:
        names = ", ".join(r.name for r in degraded)
        degraded_line = (
            f"_⚠️ PG liveness unavailable (no {PG_DSN_ENV} or psql) — {names} "
            f"shown as unknown; log/marker jobs unaffected._"
        )

    rows = ["| job | last run | latest result |",
            "|---|---|---|"]
    for r in reports:
        if r.skipped_reason:
            rows.append(f"| {r.name} | — | _{r.skipped_reason}_ |")
            continue
        if r.pg:
            rows.append(f"| {r.name} | {_pg_run_cell(r)} | {_pg_result_cell(r)} |")
            continue
        if not r.fired:
            crashed_suffix = " (crashed)" if r.tracebacks else ""
            fire_cell = f"❌ never{crashed_suffix}" if r.fired_at_pt is None else f"❌ last: {r.fired_at_pt}{crashed_suffix}"
        elif r.fired_at_pt == "now":
            fire_cell = "✓ now (this run)"
        else:
            crashed_suffix = " (crashed)" if r.tracebacks else ""
            fire_cell = f"✓ {r.fired_at_pt} PT{crashed_suffix}"
        if r.section_present is None:
            section_cell = "—"
        elif not r.section_present:
            section_cell = "❌ missing"
        elif r.section_lines is None:
            section_cell = f"_{r.section_note}_"
        else:
            note = f" ({r.section_note})" if r.section_note else ""
            section_cell = f"✓ {r.section_lines} lines{note}"
        rows.append(f"| {r.name} | {fire_cell} | {section_cell} |")

    # Format traceback details at the bottom
    diag_lines = []
    if tracebacks:
        counts = {}
        for tb in tracebacks:
            key = (tb["tool"], tb["summary"])
            counts[key] = counts.get(key, 0) + 1
            
        diag_lines.append("")
        diag_lines.append("### Tracebacks in log tail")
        for (tool, summary_str), count in sorted(counts.items()):
            count_str = f" ({count}x)" if count > 1 else ""
            diag_lines.append(f"- **{tool}**: `{summary_str}`{count_str}")

    last_present, gaps = self_liveness
    parts = [
        f"## auto-review doctor — {today_pt.isoformat()}",
        "",
        summary,
    ]
    if degraded_line:
        parts += ["", degraded_line]
    if registry_unavailable:
        # DEGRADED registry (auto-review-6mf.1 / Decision 2): the ops.jobs read
        # failed, so the moving-pieces dashboard was NOT regenerated this run (the
        # last one stands). Surfaced here so the skipped projection is visible.
        parts += ["", registry_unavailable]
    if agent_artifact_warning:
        # The artifact mismatch (auto-review-byp): producer status was 'ok' but the
        # rendered note still holds the placeholder — surfaced near the top so it's
        # not lost below the per-job table (the OMG-002 defect went unnoticed there).
        parts += ["", agent_artifact_warning]
    parts += [
        "",
        format_self_liveness(today_pt, last_present, gaps),
        "",
        f"_reporting on yesterday's check-in: `journal/checkins/{yesterday.isoformat()}.md`_",
        "",
        *rows,
    ]
    if diag_lines:
        parts.extend(diag_lines)
    parts.extend([
        "",
        f"<!-- auto-review-doctor:daily={today_pt.isoformat()} generated_at={now_utc} -->",
    ])
    
    return "\n".join(parts) + "\n"


def strip_and_replace(text: str, new_section: str) -> str:
    om = DOCTOR_MARKER_OPEN.search(text)
    cm = DOCTOR_MARKER_CLOSE.search(text)
    if om and cm and om.start() < cm.start():
        # Replace existing section; preserve trailing newline behavior.
        before = text[:om.start()]
        after = text[cm.end():]
        if after.startswith("\n"):
            after = after.lstrip("\n")
            sep = "\n"
        else:
            sep = ""
        return before + new_section + sep + after
    # Append. Ensure separation from prior content.
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    return text + new_section


def ensure_checkin(checkin_path: Path, date: dt.date) -> str:
    if checkin_path.exists():
        return checkin_path.read_text(encoding="utf-8")
    # Match the convention from existing check-in notes.
    iso = date.isoformat()
    return (
        f"---\n"
        f"created: '{iso}'\n"
        f"date: '{iso}'\n"
        f"tags:\n"
        f"- journal/checkin\n"
        f"---\n"
        f"\n"
        f"# check-in — {iso}\n"
        f"\n"
    )


def checkin_path(checkin_dir: Path, date: dt.date) -> Path:
    """Path to a daily check-in note, nested by month (auto-review-d4c).

    Layout: <checkin_dir>/YYYY/MM/YYYY-MM-DD.md. The filename keeps the full
    date so markers/links/date-keys are unchanged — only the directory nests.
    Mirrors the sibling tools' Settings.checkin_path so the doctor reads what
    they write.
    """
    return checkin_dir / f"{date:%Y}" / f"{date:%m}" / f"{date.isoformat()}.md"


def doctor_self_liveness(
    checkin_dir: Path, today_pt: dt.date, window_days: int = SELF_LIVENESS_WINDOW
) -> tuple[dt.date | None, list[dt.date]]:
    """Scan the prior `window_days` check-ins for the doctor's OWN daily marker.

    Returns (last_present_date, gap_dates) over [today-window .. today-1]. Today
    is excluded — this very run writes today's section. `gap_dates` are missing
    days that fall *after* the doctor's earliest seen run in the window, so we
    don't flag days before the doctor existed. This catches the motivating
    failure — consecutive silent misses — the moment the doctor runs again, with
    no side-channel or extra cron.
    """
    present: list[dt.date] = []
    missing: list[dt.date] = []
    for delta in range(1, window_days + 1):
        d = today_pt - dt.timedelta(days=delta)
        path = checkin_path(checkin_dir, d)
        marker = re.compile(rf"auto-review-doctor:daily={re.escape(d.isoformat())}\b")
        if path.exists() and marker.search(path.read_text(encoding="utf-8")):
            present.append(d)
        else:
            missing.append(d)
    if not present:
        return None, []
    earliest = min(present)
    gaps = sorted(d for d in missing if d > earliest)
    return max(present), gaps


def render_moving_pieces(today_pt: dt.date, registry: list[Job]) -> str:
    """Render the periodic-process registry as a standalone markdown dashboard.

    Generated from the SAME synthesized registry the doctor uses for liveness
    (now sourced from ops.jobs, auto-review-6mf.1), so the dashboard cannot drift
    from what's actually monitored. The 'monitored?' column makes coverage gaps
    (unmonitored moving pieces) visible at a glance.
    """
    now_utc = dt.datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    monitored = [j for j in registry if j.monitored]
    lines = [
        "# Moving pieces — auto-review periodic-process registry",
        "",
        f"_Generated by auto-review doctor on {today_pt.isoformat()} — DO NOT EDIT BY HAND._",
        "_Source of truth: the `ops.jobs` registry (PG); any stack change must "
        "update it via the jobs seed (see AGENTS.md)._",
        f"_{len(monitored)}/{len(registry)} pieces are liveness-monitored by the doctor; "
        "⚠️ rows are coverage gaps._",
        "",
        "| process | host | cadence | writes | monitored? |",
        "|---|---|---|---|---|",
    ]
    for j in registry:
        if j.monitored:
            mon = "✅ self" if j.marker_tool == "auto-review-doctor" else "✅"
        else:
            mon = "⚠️ no"
        lines.append(f"| {j.name} | {j.host} | {j.cadence} | {j.writes} | {mon} |")
    lines += ["", f"<!-- auto-review-doctor:moving-pieces generated_at={now_utc} -->", ""]
    return "\n".join(lines) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description="auto-review doctor v0")
    ap.add_argument("--log", type=Path, default=DEFAULT_LOG, help=f"cron.log path (default: {DEFAULT_LOG})")
    ap.add_argument("--vault", type=Path, default=DEFAULT_VAULT, help=f"vault root (default: {DEFAULT_VAULT})")
    ap.add_argument("--date", type=str, default=None, help="override today (YYYY-MM-DD, PT)")
    ap.add_argument("--tail", type=int, default=TAIL_LINES, help=f"log lines to scan (default: {TAIL_LINES})")
    ap.add_argument("--dry-run", action="store_true", help="don't write; print to stdout")
    ap.add_argument("--print", action="store_true", help="also print to stdout when writing")
    args = ap.parse_args()

    # Captured here so the recorded ops.job_runs row (auto-review-02w) reflects
    # the doctor's true start, not its finish (finished_at defaults to now() in
    # the INSERT). A now() default for started_at would fake a zero duration.
    started_at = dt.datetime.now(UTC)

    today_pt = (
        dt.date.fromisoformat(args.date)
        if args.date
        else dt.datetime.now(PT).date()
    )
    yesterday_pt = today_pt - dt.timedelta(days=1)

    log_lines = tail_lines(args.log, args.tail)
    checkin_dir = args.vault / "journal" / "checkins"
    yesterday_path = checkin_path(checkin_dir, yesterday_pt)
    today_path = checkin_path(checkin_dir, today_pt)

    yesterday_text = yesterday_path.read_text(encoding="utf-8") if yesterday_path.exists() else ""

    tracebacks = find_tracebacks(log_lines)
    dsn = os.environ.get(PG_DSN_ENV)
    pg_runs = query_latest_runs(dsn)
    # The registry now comes from ops.jobs (auto-review-6mf.1), not a hardcoded
    # JOBS list. When it's readable we synthesize the full Job list and regenerate
    # the moving-pieces dashboard from it. When it's NOT (no DSN / no psql / PG
    # down — Decision 2) we DEGRADE: synthesize only the doctor's own marker
    # self-job so the self-check still runs, do NOT regenerate moving-pieces (the
    # last one stands — never fabricate the registry from a compiled-in copy), and
    # surface a health line saying so.
    registry = query_registry(dsn)
    if registry is not None and registry_is_complete(registry):
        jobs = synthesize_jobs(registry)
        moving_pieces: str | None = render_moving_pieces(today_pt, jobs)
        registry_unavailable = None
    else:
        # Degrade on EITHER a failed read (None) OR a successful-but-incomplete one
        # (empty / missing required monitored rows — seed not applied, a row
        # deleted). An incomplete registry is NOT authoritative: trusting it would
        # under-report liveness and clobber moving-pieces.md (roborev job 1340). In
        # both cases synthesize only the doctor self-job and leave the prior
        # dashboard in place — never fabricate/half-fill it.
        jobs = synthesize_jobs(_degraded_registry_rows())
        moving_pieces = None
        if registry is None:
            registry_unavailable = (
                f"_⚠️ registry unavailable (no {PG_DSN_ENV} or psql, or PG down) — "
                f"moving-pieces not regenerated (the last dashboard stands)._"
            )
        else:
            missing = ", ".join(sorted(REQUIRED_MONITORED - {r.name for r in registry if r.monitored}))
            registry_unavailable = (
                f"_⚠️ registry INCOMPLETE — ops.jobs is missing required monitored "
                f"job(s): {missing} (seed not applied?). Treating as degraded; "
                f"moving-pieces not regenerated (the last dashboard stands)._"
            )
    # The degraded skeleton rows carry a 0h expected_interval, so judging PG-run
    # freshness against them would false-flag "overdue" even when ops.job_runs is
    # readable (the ops.jobs-incomplete-but-job_runs-fine case). Force the
    # "unknown (no PG)" path unless the registry itself was trustworthy (roborev
    # job 1352). The artifact check below still uses the real pg_runs — it's
    # registry-independent.
    registry_ok = registry is not None and registry_is_complete(registry)
    reports = assess_jobs(
        jobs, log_lines, today_pt, yesterday_text, tracebacks,
        pg_runs=(pg_runs if registry_ok else None),
    )
    push_rejections = count_push_rejections(log_lines)
    self_liveness = doctor_self_liveness(checkin_dir, today_pt)
    # Artifact assertion (auto-review-byp): is the rendered agent-review section in
    # yesterday's note the placeholder despite the producer persisting a report?
    # Quiet-day-safe — see assess_agent_artifact.
    agent_artifact_warning = assess_agent_artifact(yesterday_text, yesterday_pt, pg_runs)
    section = render_section(today_pt, reports, tracebacks, push_rejections, self_liveness, agent_artifact_warning, registry_unavailable)

    # Compact summary for the doctor's own ops.job_runs row (auto-review-02w),
    # mirroring render_section's jobs-healthy math (len(fired)/len(expected)) so
    # the recorded substrate agrees with the displayed section.
    expected = [r for r in reports if r.skipped_reason is None]
    fired = [r for r in expected if r.fired]
    doctor_summary = {
        "jobs_healthy": f"{len(fired)}/{len(expected)}",
        "tracebacks": len(tracebacks),
        "push_rejections": push_rejections,
    }

    if args.dry_run:
        # --dry-run suppresses ALL side effects, including the self-row write (it
        # must NOT leave a dead-man row), mirroring how the check-in/registry
        # writes below are skipped here.
        sys.stdout.write(section)
        if moving_pieces is not None:
            sys.stdout.write("\n----- reference/auto-review/moving-pieces.md -----\n")
            sys.stdout.write(moving_pieces)
        return 0

    today_text = ensure_checkin(today_path, today_pt)
    new_text = strip_and_replace(today_text, section)
    today_path.parent.mkdir(parents=True, exist_ok=True)
    today_path.write_text(new_text, encoding="utf-8")

    # Regenerate the moving-pieces registry dashboard (whole-file rewrite — the
    # registry is the source of truth, so this is an overwrite, not a merge).
    # DEGRADED (moving_pieces is None): the ops.jobs read failed, so we leave the
    # prior dashboard in place rather than fabricate one (Decision 2).
    if moving_pieces is not None:
        mp_path = args.vault / "reference" / "auto-review" / "moving-pieces.md"
        mp_path.parent.mkdir(parents=True, exist_ok=True)
        mp_path.write_text(moving_pieces, encoding="utf-8")

    if args.print:
        sys.stdout.write(section)
    print(f"auto-review-doctor: wrote section → {today_path}", file=sys.stderr)
    if moving_pieces is not None:
        print(f"auto-review-doctor: wrote registry → {mp_path}", file=sys.stderr)
    else:
        print("auto-review-doctor: registry unavailable — moving-pieces NOT regenerated", file=sys.stderr)

    # External dead-man substrate (auto-review-02w): record the doctor's OWN
    # ops.job_runs row LAST — after reading the other jobs' rows and rendering its
    # health output — so a row is the doctor's "I completed this run" beat. Any
    # independent process can then alarm on `now() - max(finished_at)` for this
    # job_name without re-introducing a second check-in writer. Best-effort: a
    # failed/absent write degrades silently (no DSN/psql, FK not yet applied, DB
    # down) and never changes the primary health output's exit status.
    if record_doctor_run(
        dsn,
        started_at=started_at,
        status="ok",
        summary=doctor_summary,
    ):
        print("auto-review-doctor: recorded ops.job_runs dead-man row", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
