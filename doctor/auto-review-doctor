# access is OPTIONAL: a stdlib `psql -At` subprocess (the doctor stays dependency-
# free — no psycopg), degrading to the log/marker path when there's no DSN or psql.
PG_DSN_ENV = "AUTO_REVIEW_DOCTOR_PG_DSN"
PSQL_TIMEOUT_S = 10
# One latest row per job_name. finished_at is rendered as the same UTC "…Z" ISO
# string parse_utc_iso() already understands; cost_usd as plain text ('' if NULL).
SQL_LATEST_RUNS = (
    "SELECT DISTINCT ON (job_name) job_name, "
    "to_char(finished_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'), "
    "status, coalesce(cost_usd::text, '') "
    "FROM ops.job_runs ORDER BY job_name, finished_at DESC"
)
# How many prior days the doctor scans for its OWN section, to detect missed
# runs (the motivating failure: consecutive silent misses nobody noticed).
