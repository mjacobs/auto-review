#!/usr/bin/env python3
"""auto-review doctor v0 — health check for the auto-review sibling crons.

Reads the deploy host's cron.log tail and yesterday's check-in note, renders a
marker-bracketed health section, strip-and-replaces it into today's check-in.

v0 scope per beads `auto-review-fs7`: single-file script, no package, no
pyproject. Promote to a full sibling (auto-review-doctor/) after ~1 week
of cron runs proves the report shape is useful.

Run `auto-review-doctor --help` for CLI.
"""

from __future__ import annotations

import argparse
import datetime as dt
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path
from zoneinfo import ZoneInfo

PT = ZoneInfo("America/Los_Angeles")
UTC = ZoneInfo("UTC")

DEFAULT_LOG = Path.home() / ".local/state/auto-review/cron.log"
DEFAULT_VAULT = Path.home() / "vault"
TAIL_LINES = 1000

# (job_id, cron_hhmm_PT, commit_regex, sibling_marker_tool, weekly?, marker_key)
JOBS = [
    ("vault-review daily",       "20:01", re.compile(r"\[main [0-9a-f]+\] vault-review: daily recap (\S+Z)"),    "vault-review",        False, "daily"),
    ("memex-review daily",       "20:31", re.compile(r"\[main [0-9a-f]+\] memex-review: daily inbox (\S+Z)"),    "memex-review",        False, "daily"),
    ("agent-review daily",       "21:01", re.compile(r"\[main [0-9a-f]+\] agent-review: daily report (\S+Z)"),   "agent-review",        False, "report_date"),
    ("auto-review-doctor daily", "22:01", re.compile(r"\[main [0-9a-f]+\] auto-review doctor: daily health (\S+Z)"), "auto-review-doctor", False, "daily"),
    ("vault-review weekly",      "10:01", re.compile(r"\[main [0-9a-f]+\] vault-review: weekly recap (\S+Z)"),   "vault-review",        True,  "weekly"),
]

DOCTOR_MARKER_OPEN  = re.compile(r"^## auto-review doctor — \d{4}-\d{2}-\d{2}.*$", re.MULTILINE)
DOCTOR_MARKER_CLOSE = re.compile(r"^<!-- auto-review-doctor:daily=\d{4}-\d{2}-\d{2} generated_at=\S+ -->$", re.MULTILINE)


@dataclass
class JobReport:
    name: str
    expected_hhmm: str
    fired: bool
    fired_at_pt: str | None      # "20:01" if today, "(2026-05-15)" if older
    section_present: bool | None  # None = N/A (not expected today)
    section_lines: int | None
    section_note: str             # "0 captures", "" etc.
    skipped_reason: str | None    # e.g. "weekly — Sundays only"
    tracebacks: list[str] = field(default_factory=list)


def tail_lines(path: Path, n: int) -> list[str]:
    if not path.exists():
        return []
    # Stdlib-friendly tail: read whole file. cron.log is ~6k lines today;
    # rotation work (auto-review-75t) is tracked separately. Good enough for v0.
    with path.open("r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    return lines[-n:]


def parse_utc_iso(s: str) -> dt.datetime:
    # "2026-05-18T03:01:01Z"
    return dt.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)


def latest_match(lines: list[str], pattern: re.Pattern[str]) -> tuple[str, dt.datetime] | None:
    last: tuple[str, dt.datetime] | None = None
    for line in lines:
        m = pattern.search(line)
        if m:
            try:
                last = (line.rstrip(), parse_utc_iso(m.group(1)))
            except ValueError:
                continue
    return last


def section_info(text: str, tool: str, marker_key: str, label: str) -> tuple[bool, int, str]:
    """Find `<!-- {tool}:{marker_key}={label} ... -->` and its matching `## {tool} …` heading.

    `marker_key`/`label` are "daily"/"YYYY-MM-DD" or "weekly"/"YYYY-W##", matching the
    marker each sibling emits (see vault-review's vault.py).

    Returns (present, line_count_inside, note).
    """
    close_marker = re.compile(
        rf"^<!--\s*{re.escape(tool)}:{re.escape(marker_key)}={re.escape(label)}\s+generated_at=\S+\s*-->$",
        re.MULTILINE,
    )
    cm = close_marker.search(text)
    if not cm:
        return (False, 0, "")
    # The close marker already pins tool+kind+label, so the section start is just
    # the nearest `## {tool} …` heading before it. Don't key the heading on the
    # date — weekly headings are keyed on the week, not a daily date. Consume the
    # whole heading line so its text stays out of the body line count.
    open_marker = re.compile(rf"^##\s+{re.escape(tool)}\b[^\n]*$", re.MULTILINE)
    om = None
    for m in open_marker.finditer(text):
        if m.start() < cm.start():
            om = m
    if not om:
        return (True, 0, "(close marker found, open heading missing)")
    body = text[om.end():cm.start()]
    line_count = sum(1 for line in body.splitlines() if line.strip())
    note = ""
    if "0 captures" in body or "no captures in window" in body:
        note = "0 captures"
    return (True, line_count, note)


def find_tracebacks(lines: list[str]) -> list[dict[str, str]]:
    tracebacks = []
    n = len(lines)
    i = 0
    while i < n:
        if lines[i].startswith("Traceback (most recent call last):"):
            block_lines = [lines[i]]
            j = i + 1
            while j < n:
                if lines[j].startswith(" ") or lines[j].startswith("\t") or not lines[j].strip():
                    block_lines.append(lines[j])
                    j += 1
                else:
                    block_lines.append(lines[j])
                    j += 1
                    break
            
            file_path = None
            line_no = None
            for tbl in reversed(block_lines):
                m = re.search(r'File "([^"]+)", line (\d+)', tbl)
                if m:
                    file_path = m.group(1)
                    line_no = m.group(2)
                    break
            
            exc_line = block_lines[-1].strip() if block_lines else "UnknownError"
            
            tool = "other"
            if file_path:
                fp_lower = file_path.lower()
                if "vault-review" in fp_lower or "vault_review" in fp_lower:
                    tool = "vault-review"
                elif "memex-review" in fp_lower or "memex_review" in fp_lower:
                    tool = "memex-review"
                elif "agent-review" in fp_lower or "agent_review" in fp_lower:
                    tool = "agent-review"
                elif "doctor" in fp_lower or "auto-review-doctor" in fp_lower:
                    tool = "auto-review-doctor"
            
            exc_match = re.match(r'^([\w\.]+):\s*(.*)$', exc_line)
            if exc_match:
                exc_type = exc_match.group(1).split('.')[-1]
                exc_msg = exc_match.group(2)
                exc_summary = f"{exc_type}: {exc_msg}"
            else:
                exc_summary = exc_line
            
            loc = ""
            if file_path:
                loc = f" ({Path(file_path).name}:{line_no})"
            
            tracebacks.append({
                "tool": tool,
                "summary": f"{exc_summary}{loc}",
                "full_text": "".join(block_lines)
            })
            i = j
        else:
            i += 1
    return tracebacks


# git's per-ref rejection line, e.g. " ! [rejected]  main -> main (non-fast-forward)".
# One match == one rejected push. Healed automatically by the wrappers' rebase+retry
# (464110b), so this is a tripwire for the rare double-race, not a hard failure.
PUSH_REJECT = re.compile(r"!\s+\[rejected\].*\((?:non-fast-forward|fetch first)\)")


def count_push_rejections(lines: list[str]) -> int:
    return sum(1 for line in lines if PUSH_REJECT.search(line))


def assess_jobs(
    log_lines: list[str],
    today_pt: dt.date,
    yesterday_checkin_text: str,
    weekly_text: str,
    tracebacks: list[dict[str, str]],
) -> list[JobReport]:
    is_sunday = today_pt.weekday() == 6
    reports: list[JobReport] = []
    for name, hhmm, regex, sibling_tool, is_weekly, marker_key in JOBS:
        if is_weekly and not is_sunday:
            reports.append(JobReport(
                name=name, expected_hhmm=hhmm, fired=False, fired_at_pt=None,
                section_present=None, section_lines=None, section_note="",
                skipped_reason="weekly — Sundays only",
                tracebacks=[],
            ))
            continue
        if sibling_tool == "auto-review-doctor":
            # Self-row. We can't see our own commit yet (it happens after this
            # script exits, in the cron wrapper), and our own section is the
            # one being rendered right now. Hardcode both cells to reflect that.
            reports.append(JobReport(
                name=name, expected_hhmm=hhmm, fired=True, fired_at_pt="now",
                section_present=True, section_lines=None, section_note="self — see this section",
                skipped_reason=None,
                tracebacks=[],
            ))
            continue
        match = latest_match(log_lines, regex)
        
        # Get tracebacks for this tool
        job_tracebacks = [tb["summary"] for tb in tracebacks if tb["tool"] == sibling_tool]
        
        if match is None:
            reports.append(JobReport(
                name=name, expected_hhmm=hhmm, fired=False, fired_at_pt=None,
                section_present=False, section_lines=0, section_note="",
                skipped_reason=None,
                tracebacks=job_tracebacks,
            ))
            continue
        _, ts_utc = match
        ts_pt = ts_utc.astimezone(PT)
        fired_today = ts_pt.date() == today_pt
        fired_at = ts_pt.strftime("%H:%M") if fired_today else f"({ts_pt.date().isoformat()})"
        if is_weekly:
            # The weekly cron runs `run-weekly last-week`, writing a section for the
            # ISO week *before* the Sunday it fires, into journal/weekly/YYYY-W##.md
            # keyed `:weekly=YYYY-W##`.
            present, lines, note = section_info(
                weekly_text, sibling_tool, marker_key, reported_week_label(today_pt)
            )
        else:
            yesterday = today_pt - dt.timedelta(days=1)
            present, lines, note = section_info(
                yesterday_checkin_text, sibling_tool, marker_key, yesterday.isoformat()
            )
        reports.append(JobReport(
            name=name, expected_hhmm=hhmm, fired=fired_today,
            fired_at_pt=fired_at, section_present=present, section_lines=lines,
            section_note=note, skipped_reason=None,
            tracebacks=job_tracebacks,
        ))
    return reports


def render_section(today_pt: dt.date, reports: list[JobReport], tracebacks: list[dict[str, str]], push_rejections: int) -> str:
    now_utc = dt.datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    expected = [r for r in reports if r.skipped_reason is None]
    fired = [r for r in expected if r.fired]
    yesterday = today_pt - dt.timedelta(days=1)
    
    tb_count = len(tracebacks)
    reject_cell = f"{push_rejections} push rejections" if push_rejections == 0 else f"⚠️ {push_rejections} push rejections"
    summary = f"_{len(fired)}/{len(expected)} jobs fired today · {tb_count} tracebacks · {reject_cell} in log tail_"

    rows = ["| job | fired today | section in yesterday's check-in |",
            "|---|---|---|"]
    for r in reports:
        if r.skipped_reason:
            rows.append(f"| {r.name} | — | _{r.skipped_reason}_ |")
            continue
        if not r.fired:
            crashed_suffix = " (crashed)" if r.tracebacks else ""
            fire_cell = f"❌ never{crashed_suffix}" if r.fired_at_pt is None else f"❌ last: {r.fired_at_pt}{crashed_suffix}"
        elif r.fired_at_pt == "now":
            fire_cell = "✓ now (this run)"
        else:
            crashed_suffix = " (crashed)" if r.tracebacks else ""
            fire_cell = f"✓ {r.fired_at_pt} PT{crashed_suffix}"
        if r.section_present is None:
            section_cell = "—"
        elif not r.section_present:
            section_cell = "❌ missing"
        elif r.section_lines is None:
            section_cell = f"_{r.section_note}_"
        else:
            note = f" ({r.section_note})" if r.section_note else ""
            section_cell = f"✓ {r.section_lines} lines{note}"
        rows.append(f"| {r.name} | {fire_cell} | {section_cell} |")

    # Format traceback details at the bottom
    diag_lines = []
    if tracebacks:
        counts = {}
        for tb in tracebacks:
            key = (tb["tool"], tb["summary"])
            counts[key] = counts.get(key, 0) + 1
            
        diag_lines.append("")
        diag_lines.append("### Tracebacks in log tail")
        for (tool, summary_str), count in sorted(counts.items()):
            count_str = f" ({count}x)" if count > 1 else ""
            diag_lines.append(f"- **{tool}**: `{summary_str}`{count_str}")

    parts = [
        f"## auto-review doctor — {today_pt.isoformat()}",
        "",
        summary,
        "",
        f"_reporting on yesterday's check-in: `journal/checkins/{yesterday.isoformat()}.md`_",
        "",
        *rows,
    ]
    if diag_lines:
        parts.extend(diag_lines)
    parts.extend([
        "",
        f"<!-- auto-review-doctor:daily={today_pt.isoformat()} generated_at={now_utc} -->",
    ])
    
    return "\n".join(parts) + "\n"


def strip_and_replace(text: str, new_section: str) -> str:
    om = DOCTOR_MARKER_OPEN.search(text)
    cm = DOCTOR_MARKER_CLOSE.search(text)
    if om and cm and om.start() < cm.start():
        # Replace existing section; preserve trailing newline behavior.
        before = text[:om.start()]
        after = text[cm.end():]
        if after.startswith("\n"):
            after = after.lstrip("\n")
            sep = "\n"
        else:
            sep = ""
        return before + new_section + sep + after
    # Append. Ensure separation from prior content.
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    return text + new_section


def ensure_checkin(checkin_path: Path, date: dt.date) -> str:
    if checkin_path.exists():
        return checkin_path.read_text(encoding="utf-8")
    # Match the convention from existing check-in notes.
    iso = date.isoformat()
    return (
        f"---\n"
        f"created: '{iso}'\n"
        f"date: '{iso}'\n"
        f"tags:\n"
        f"- journal/checkin\n"
        f"---\n"
        f"\n"
        f"# check-in — {iso}\n"
        f"\n"
    )


def iso_week_label(date: dt.date) -> str:
    iso_year, iso_week, _ = date.isocalendar()
    return f"{iso_year}-W{iso_week:02d}"


def reported_week_label(today: dt.date) -> str:
    """ISO-week label the Sunday weekly recap covers: `last-week` relative to the
    run day, matching `vault-review run-weekly last-week`."""
    return iso_week_label(today - dt.timedelta(weeks=1))


def weekly_note_path(vault: Path, week_label: str) -> Path:
    return vault / "journal" / "weekly" / f"{week_label}.md"


def main() -> int:
    ap = argparse.ArgumentParser(description="auto-review doctor v0")
    ap.add_argument("--log", type=Path, default=DEFAULT_LOG, help=f"cron.log path (default: {DEFAULT_LOG})")
    ap.add_argument("--vault", type=Path, default=DEFAULT_VAULT, help=f"vault root (default: {DEFAULT_VAULT})")
    ap.add_argument("--date", type=str, default=None, help="override today (YYYY-MM-DD, PT)")
    ap.add_argument("--tail", type=int, default=TAIL_LINES, help=f"log lines to scan (default: {TAIL_LINES})")
    ap.add_argument("--dry-run", action="store_true", help="don't write; print to stdout")
    ap.add_argument("--print", action="store_true", help="also print to stdout when writing")
    args = ap.parse_args()

    today_pt = (
        dt.date.fromisoformat(args.date)
        if args.date
        else dt.datetime.now(PT).date()
    )
    yesterday_pt = today_pt - dt.timedelta(days=1)

    log_lines = tail_lines(args.log, args.tail)
    checkin_dir = args.vault / "journal" / "checkins"
    yesterday_path = checkin_dir / f"{yesterday_pt.isoformat()}.md"
    today_path = checkin_dir / f"{today_pt.isoformat()}.md"
    weekly_path = weekly_note_path(args.vault, reported_week_label(today_pt))

    yesterday_text = yesterday_path.read_text(encoding="utf-8") if yesterday_path.exists() else ""
    weekly_text = weekly_path.read_text(encoding="utf-8") if weekly_path.exists() else ""

    tracebacks = find_tracebacks(log_lines)
    reports = assess_jobs(log_lines, today_pt, yesterday_text, weekly_text, tracebacks)
    push_rejections = count_push_rejections(log_lines)
    section = render_section(today_pt, reports, tracebacks, push_rejections)

    if args.dry_run:
        sys.stdout.write(section)
        return 0

    today_text = ensure_checkin(today_path, today_pt)
    new_text = strip_and_replace(today_text, section)
    today_path.parent.mkdir(parents=True, exist_ok=True)
    today_path.write_text(new_text, encoding="utf-8")

    if args.print:
        sys.stdout.write(section)
    print(f"auto-review-doctor: wrote section → {today_path}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
