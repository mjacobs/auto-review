# agent_review.daily_reports row for the day (renderer/src/checkin_renderer/
# sections/agent.py → render_agent_section, report is None). It's an f-string
# `_no agent-review report row for {date}_`; this is the stable prefix. The
# doctor can't import the renderer package (it's a standalone stdlib script), so
# the literal is duplicated here and a test (test_doctor.py) asserts this prefix
# still appears in sections/agent.py so the two can't silently drift apart.
AGENT_PLACEHOLDER_PREFIX = "_no agent-review report row for "
# How many prior days the doctor scans for its OWN section, to detect missed
# runs (the motivating failure: consecutive silent misses nobody noticed).
SELF_LIVENESS_WINDOW = 7

@dataclass(frozen=True)
class Job:
    """One entry in the periodic-process registry — a moving piece of the
    auto-review stack.

    Jobs are SYNTHESIZED from ops.jobs rows (the registry's source of truth,
    auto-review-6mf.1) via synthesize_jobs(): the registry fields (name/host/
    cadence/writes/monitored) come from PG; the leak-free liveness mechanics
    (marker regex / weekly params) are grafted on from LIVENESS_SPECS.
    Monitored entries carry the fields the doctor uses to check liveness;
    UNMONITORED infra is catalogued (monitored=False) so the registry lists
    EVERYTHING and the 'monitored?' column in the generated moving-pieces doc
    surfaces coverage gaps. ANY change to the periodic-job stack MUST update
    ops.jobs (see AGENTS.md → "Periodic-process registry").
    """
    name: str
    host: str
    cadence: str          # human-readable expected schedule (for the doc)
    writes: str           # what it produces
    monitored: bool       # does the doctor check this job's liveness?
    # ── liveness config — only meaningful when monitored ──
    # A monitored job is checked one of two ways: the legacy MARKER path (a
    # cron.log commit line + a check-in marker — vault-review, doctor self) or
    # the PG path (a fresh ops.job_runs row — the PG writers, auto-review-hg6.8).
    hhmm: str = ""                              # expected fire time PT (marker path)
    commit_regex: re.Pattern[str] | None = None
    marker_tool: str = ""
    marker_key: str = ""
    # PG path: when pg_job_name is set, liveness is "is the latest ops.job_runs
    # row younger than pg_interval_hours?" instead of log+marker.
    pg_job_name: str = ""
    pg_interval_hours: float = 0.0
    # PG WEEKLY path (auto-review-2vv): a weekly cron's liveness can't use a flat
    # age window (a real miss would stay green for ~8 days; a tight window would
    # false-positive every Monday before the fire — the hg6.12 BUG2 shape).
    # Instead the doctor compares the latest row against the most-recent EXPECTED
    # weekly fire: overdue only once that fire-time + grace has passed without a
    # fresh row. pg_weekly_dow/hhmm pin the schedule (PT); pg_grace_hours is the
    # post-fire slack before flagging.
    pg_weekly: bool = False
    pg_weekly_dow: int = 0          # Monday (matches dt.date.weekday())
    pg_weekly_hhmm: str = "00:08"   # expected fire time PT
    pg_grace_hours: float = 2.0     # slack after the expected fire before "overdue"


@dataclass(frozen=True)
class JobRow:
    """One ops.jobs registry row (auto-review-6mf.1).

    The registry is sourced from PG (ops.jobs) — the host/cadence strings are
    CONTENT (they name internal hosts/schedules) and must stay out of this public
    repo. `expected_interval_hours` is the flat liveness window
    (ops.jobs.expected_interval), decimal hours; 0.0 when NULL. This carries only
    leak-free registry data; the executable liveness MECHANICS (regexes, weekly
    schedule params) live in LIVENESS_SPECS, keyed by `name`.
    """
    name: str
    host: str
    cadence: str
    writes: str
    monitored: bool
    expected_interval_hours: float


@dataclass(frozen=True)
class LivenessSpec:
    """The in-code liveness MECHANICS for a job, keyed by ops.jobs.name.

    Registry data (name/host/cadence/writes/monitored/expected_interval) is
    content and lives in PG; the mechanics — the marker-path regex+markers and
    the schedule-aware weekly params — are executable code that leak nothing, so
    they stay in the repo (design: 2026-06-30-jobs-registry-pg.md, Decision 1).
    A monitored job ABSENT from LIVENESS_SPECS uses the DEFAULT PG liveness:
    "latest ops.job_runs row younger than expected_interval?". Only the two
    special shapes need an entry — the marker-path self-check and the weekly job.
    """
    # ── marker path (legacy: cron.log commit line + check-in marker) ──
    marker: bool = False
    hhmm: str = ""
    commit_regex: re.Pattern[str] | None = None
    marker_tool: str = ""
    marker_key: str = ""
    # ── PG-weekly path (schedule-aware, not a flat age window) ──
    pg_weekly: bool = False
    pg_weekly_dow: int = 0          # Monday (matches dt.date.weekday())
    pg_weekly_hhmm: str = "00:08"   # expected fire time PT
    pg_grace_hours: float = 2.0     # slack after the expected fire before "overdue"


# The two jobs whose liveness is NOT the default flat-window PG check. Everything
# else that is monitored=True in ops.jobs falls through to the default PG path.
LIVENESS_SPECS: dict[str, LivenessSpec] = {
    # The doctor's own self-row: the last remaining MARKER-path job (the others
    # moved to ops.job_runs liveness). "fired" reflects this very run; the section
    # cell is a real check of yesterday's check-in for our own marker.
    "auto-review-doctor": LivenessSpec(
        marker=True, hhmm="00:22",
        commit_regex=re.compile(r"\[main [0-9a-f]+\] auto-review doctor: daily health (\S+Z)"),
        marker_tool="auto-review-doctor", marker_key="daily",
    ),
    # SCHEDULE-AWARE weekly (auto-review-2vv): not a flat age window — overdue ONLY
    # once the most-recent expected Monday fire (+grace) has passed without a fresh
    # row (green the rest of the week off one real run; no pre-fire-Monday BUG2).
    "vault-review-weekly": LivenessSpec(
        pg_weekly=True, pg_weekly_dow=0, pg_weekly_hhmm="00:08", pg_grace_hours=2.0,
    ),
}


# The monitored jobs the doctor MUST see in ops.jobs for a read to be trusted. A
# successful-but-incomplete result (seed not applied, a row deleted) is NOT
# authoritative: trusting it would silently under-report liveness AND overwrite
# moving-pieces.md with a half-empty dashboard (roborev job 1340). Missing any of
# these → take the degraded path. Names only (leak-free): the two LIVENESS_SPECS
# specials plus the four default-PG writers.
REQUIRED_MONITORED: frozenset[str] = frozenset({
    "auto-review-doctor", "vault-review-weekly",
    "agent-review", "checkin-renderer-daily", "memex-sync", "vault-review-daily",
})


def registry_is_complete(rows: list[JobRow]) -> bool:
    """True iff every REQUIRED_MONITORED job is present as a monitored row.

    Guards the doctor against a successful-but-partial ops.jobs read (empty result,
    seed not applied, a row deleted). Such a result must not be treated as
    authoritative — the caller takes the degraded path instead (roborev job 1340)."""
    present = {r.name for r in rows if r.monitored}
    return REQUIRED_MONITORED <= present


def synthesize_jobs(rows: list[JobRow]) -> list[Job]:
    """Reconstruct the Job registry from ops.jobs rows + the LIVENESS_SPECS map.

    Each row supplies the registry fields (name/host/cadence/writes/monitored);
    the in-code mechanics map supplies the leak-free execution config keyed by
    name. Four shapes (design Decision 1):
      * marker spec  → marker-path job (the doctor self-row);
      * weekly spec  → schedule-aware PG-weekly job;
      * monitored, no spec → default PG liveness (flat expected_interval window);
      * unmonitored  → catalogued only (registry fields, no liveness config).
    This yields exactly the old hand-written JOBS list, but with hosts/schedules
    now coming from PG instead of the repo.
    """
    jobs: list[Job] = []
    for row in rows:
        spec = LIVENESS_SPECS.get(row.name)
        common = dict(
            name=row.name, host=row.host, cadence=row.cadence,
            writes=row.writes, monitored=row.monitored,
        )
        if spec and spec.marker:
            jobs.append(Job(
                **common, hhmm=spec.hhmm, commit_regex=spec.commit_regex,
                marker_tool=spec.marker_tool, marker_key=spec.marker_key,
            ))
        elif spec and spec.pg_weekly:
            jobs.append(Job(
                **common, pg_job_name=row.name,
                pg_interval_hours=row.expected_interval_hours,
                pg_weekly=True, pg_weekly_dow=spec.pg_weekly_dow,
                pg_weekly_hhmm=spec.pg_weekly_hhmm, pg_grace_hours=spec.pg_grace_hours,
            ))
        elif row.monitored:
            jobs.append(Job(
                **common, pg_job_name=row.name,
                pg_interval_hours=row.expected_interval_hours,
            ))
        else:
            jobs.append(Job(**common))
    return jobs


def _doctor_self_row() -> JobRow:
    """The degraded-mode fallback registry row for the doctor's OWN marker
    self-check, built with NO content fields (host/cadence/writes empty) so it
    re-introduces no host/schedule strings. When the PG registry is unreadable
    (Decision 2) this keeps the marker self-liveness path running; everything
    else — the PG-writer liveness and the moving-pieces dashboard — degrades."""
    return JobRow(
        name=DOCTOR_JOB_NAME, host="", cadence="", writes="",
        monitored=True, expected_interval_hours=0.0,
    )


def _degraded_registry_rows() -> list[JobRow]:
    """Skeleton rows for ALL REQUIRED_MONITORED jobs, content fields EMPTY
    (leak-free), used when the real ops.jobs read failed or was incomplete
    (Decision 2). Synthesizing these keeps the PG jobs VISIBLE: assessed with
    pg_runs=None they render as "⚠️ unknown (no PG)" and do NOT count as healthy,
    so the degraded section can't report a misleading "1/1 healthy" and mask a
    real outage (roborev job 1346). The doctor's own row still drives the marker
    self-check via LIVENESS_SPECS. Names only — no host/schedule strings re-enter
    the repo."""
    rows = [_doctor_self_row()]
    rows += [
        JobRow(name=n, host="", cadence="", writes="", monitored=True,
               expected_interval_hours=0.0)
        for n in sorted(REQUIRED_MONITORED) if n != DOCTOR_JOB_NAME
    ]
    return rows


