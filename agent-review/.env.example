# Postgres DSN for the agentsview database.
# Format: postgresql://USER[:PASSWORD]@HOST:PORT/DBNAME
# If PASSWORD is omitted, agent-review will look for it in PGPASSFILE,
# then ./.pgpass, then ~/.pgpass. Example .pgpass line:
# HOST:PORT:DBNAME:USER:PASSWORD
PG_DSN=postgresql://admin@POSTGRES_HOST:5432/agentsview

# LLM API key for the endpoint at LLM_BASE_URL (defaults to api.anthropic.com).
# When pointed at a LiteLLM gateway, this is a scoped virtual key; otherwise a
# direct provider key.
LLM_API_KEY=sk-...

# Optional: override the LLM SDK base URL. Set to a LiteLLM gateway URL to
# route through a per-client virtual key. Leave unset to call Anthropic directly.
# LLM_BASE_URL=https://llm.example.internal

# Path to the Obsidian vault root (default: ~/vault).
VAULT_PATH=/home/mj/vault

# Timezone for day boundaries.
TZ=America/Los_Angeles

# Models per stage.
MODEL_DIGEST=claude-haiku-4-5-20251001
MODEL_SYNTH=claude-sonnet-4-6
