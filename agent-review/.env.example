# Postgres DSN for the agentsview database.
# Format: postgresql://USER[:PASSWORD]@HOST:PORT/DBNAME
# If PASSWORD is omitted, agent-review will look for it in PGPASSFILE,
# then ./.pgpass, then ~/.pgpass. Example .pgpass line:
# HOST:PORT:DBNAME:USER:PASSWORD
PG_DSN=postgresql://admin@db.example.com:5432/agentsview

# LLM backend for the digest (Haiku) and synth (Sonnet) calls:
#   claude_cli  — shell out to `claude -p`; billed to the Claude Max
#                 subscription's programmatic quota. No API key required.
#                 Requires the Claude Code CLI installed AND authenticated to
#                 the subscription on this host (see README "LLM backends").
#   api         — the anthropic SDK over LLM_API_KEY / LLM_BASE_URL. Direct
#                 Anthropic, or a LiteLLM gateway fronting a local model.
# Default: claude_cli.
LLM_BACKEND=claude_cli

# Per-stage backends, pinned explicitly. Each would default to LLM_BACKEND when
# unset, but we pin them so a future package default-flip can't silently
# re-break a stage: in 2026-06 a claude_cli default flip shelled the api-only
# MODEL_DIGEST=local-coder to `claude -p --model local-coder`, which 404'd and
# stayed broken ~3 days. Pinning keeps the backend↔model pairing coherent.
# (config.py now also fails fast on a claude_cli backend + non-Claude model.)
# To mix backends — e.g. digest on a local model via the gateway, synth on the
# subscription — set LLM_BACKEND_DIGEST=api (with MODEL_DIGEST=local-coder +
# LLM_API_KEY + LLM_BASE_URL) and leave LLM_BACKEND_SYNTH=claude_cli.
LLM_BACKEND_DIGEST=claude_cli
LLM_BACKEND_SYNTH=claude_cli

# OPTIONAL — api backend only; NOT used by the default claude_cli backend.
# Required only when a stage's backend is 'api'. When pointed at a LiteLLM
# gateway this is a scoped virtual key; otherwise a direct provider key. Leaving
# it set while every stage runs on claude_cli is harmless but does nothing
# (config.py warns about the dead-weight knob).
# LLM_API_KEY=sk-...

# OPTIONAL — api backend only; NOT used by the default claude_cli backend.
# Overrides the LLM SDK base URL. Set to a LiteLLM gateway URL to route an api
# stage to a local/other model. Leave unset to call Anthropic directly.
# LLM_BASE_URL=https://llm.example.internal

# Optional (claude_cli backend): path to the claude binary and per-call timeout.
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_TIMEOUT=300
# CLAUDE_CLI_EXTRA_ARGS=

# Timezone for day boundaries.
TZ=America/Los_Angeles

# Models per stage.
MODEL_DIGEST=claude-haiku-4-5-20251001
MODEL_SYNTH=claude-sonnet-4-6

# Schema name for the upstream read-only database (default: agentsview).
# Override if your deployment uses a different schema name.
# AGENT_REVIEW_PG_SCHEMA=agentsview

# Comma-separated session-id prefixes treated as automated (non-human) when the
# upstream is_automated flag is unreliable. Default: "hermes:cron_".
# AGENT_REVIEW_AUTOMATED_ID_PREFIXES=hermes:cron_
