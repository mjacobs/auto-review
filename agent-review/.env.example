# Postgres DSN for the agentsview database.
# Format: postgresql://USER[:PASSWORD]@HOST:PORT/DBNAME
# If PASSWORD is omitted, agent-review will look for it in PGPASSFILE,
# then ./.pgpass, then ~/.pgpass. Example .pgpass line:
# HOST:PORT:DBNAME:USER:PASSWORD
PG_DSN=postgresql://admin@POSTGRES_HOST:5432/agentsview

# Anthropic API key (also picked up from environment if already exported).
ANTHROPIC_API_KEY=sk-ant-...

# Path to the Obsidian vault root (default: ~/vault).
VAULT_PATH=/home/mj/vault

# Timezone for day boundaries.
TZ=America/Los_Angeles

# Models per stage.
MODEL_DIGEST=claude-haiku-4-5-20251001
MODEL_SYNTH=claude-sonnet-4-6
