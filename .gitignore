__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.pgpass
.pytest_cache/
.ruff_cache/
.coverage
dist/
build/
uv.lock

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# bv (beads viewer) local config and caches
.bv/

# Beads task tracker (local-only)
.beads/

# roborev snapshots
/.roborev/

# DB seeds carry local-only detail — absolute home paths (projects) and internal
# hostnames (jobs) — so keep the real seeds out of this public repo; the README +
# sanitized *.example.sql files stay tracked.
/db/seed/*
!/db/seed/README.md
!/db/seed/projects.seed.example.sql
!/db/seed/jobs.seed.example.sql
