__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.pgpass
.pytest_cache/
.ruff_cache/
.coverage
dist/
build/
uv.lock

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# bv (beads viewer) local config and caches
.bv/

# Beads task tracker (local-only)
.beads/

# roborev snapshots
/.roborev/

# DB seeds carry absolute local home paths — keep the real seed out of this
# public repo; the README + sanitized example stay tracked.
/db/seed/*
!/db/seed/README.md
!/db/seed/projects.seed.example.sql
