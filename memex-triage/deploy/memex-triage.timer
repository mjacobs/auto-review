[Unit]
Description=Run memex-triage every 5 minutes

[Timer]
# Every 5 minutes on the wall clock. OnCalendar + Persistent (not a monotonic
# OnUnitActiveSec) is what gives catch-up after the desktop sleeps/reboots:
# systemd records the last run and fires once on resume if a slot was missed.
OnCalendar=*:0/5
Persistent=true
# Stagger off the exact minute boundary so we don't collide with other jobs.
RandomizedDelaySec=20

[Install]
WantedBy=timers.target
