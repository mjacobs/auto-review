# Copy to .env and fill in. On dev this typically already lives in ~/.secrets.
# DSN for the memex_triage role; omit the password to use ~/.pgpass (or a
# repo-local .pgpass, gitignored).
MEMEX_TRIAGE_PG_DSN=postgresql://memex_triage@<pg-host>:5432/<db>

# Optional (default shown). Display timezone for the listing's HH:MM column.
# TZ=America/Los_Angeles
