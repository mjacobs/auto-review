# Copy to .env and fill in. On dev these typically already live in ~/.secrets.
# DSN for the memex_sync role; omit the password to use ~/.pgpass (or a
# repo-local .pgpass, gitignored).
PG_DSN=postgresql://memex_sync@<pg-host>:5432/<db>
MEMEX_URL=
MEMEX_CLIENT_ID=
MEMEX_CLIENT_SECRET=

# Optional (defaults shown)
# MEMEX_SYNC_CONSUMER=memex_sync
# MEMEX_SYNC_JOB_NAME=memex-sync
# MEMEX_SYNC_HOST=          # defaults to hostname
